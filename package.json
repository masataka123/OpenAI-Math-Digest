{
  "name": "openai-math-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test scripts/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "citations": "node scripts/sync-citations.mjs",
    "check:citations": "node scripts/sync-citations.mjs --check",
    "diagrams": "node scripts/render-proof-diagrams.mjs",
    "diagrams:catalog": "node scripts/render-catalog-diagrams.mjs",
    "pdf:catalog": "node scripts/build-catalog-pdf.mjs",
    "check:pdf": "node scripts/build-catalog-pdf.mjs --check",
    "test:pdf": "node --test scripts/pdf/pipeline.test.mjs",
    "catalog:prepare": "node scripts/prepare-catalog.mjs",
    "pdf:doctor": "node scripts/pdf/runtime.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "test:browser": "node --test scripts/browser/browser.test.mjs",
    "comics:plan": "node scripts/comics/run.mjs plan",
    "comics:prepare": "node scripts/comics/run.mjs prepare",
    "comics:serve": "node scripts/comics/run.mjs serve",
    "comics:review": "node scripts/comics/run.mjs review",
    "comics:publish": "node scripts/comics/run.mjs publish",
    "comics:verify": "node scripts/comics/run.mjs verify",
    "comics:status": "node scripts/comics/run.mjs status"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "6.3.6",
    "astro": "5.13.2"
  },
  "devDependencies": {
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "mathjax-full": "3.2.2",
    "playwright-core": "1.62.1"
  }
}
