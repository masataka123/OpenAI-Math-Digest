---
import Layout from '../layouts/Layout.astro';
import DependencyTable from '../components/DependencyTable.astro';
import CatalogDependencies from '../components/CatalogDependencies.astro';
import ProofDiagram from '../components/ProofDiagram.astro';
import {synthesis} from '../data/catalog-034-synthesis.mjs';
import pdfEditions from '../data/pdf-editions.json';
import {catalogs,papers,languages,fieldsForCatalog,paperSource,officialCatalog,officialOverview,sourceCommit} from '../data/site.mjs';
import {catalogueNotes,notesById,catalogueDependencies,themes} from '../data/catalog-034.mjs';
import '../styles/paper.css';
import '../styles/catalog.css';
const {catalog:c,lang}=Astro.props,en=lang==='en',base=import.meta.env.BASE_URL,relatedFields=fieldsForCatalog(c.id);
const orderedPapers=c.paperIds.map(id=>papers.find(p=>p.id===id));
const pdf=pdfEditions[c.id]?.[lang] ?? (c.id==='034'?pdfEditions[lang]:null);
const number=id=>String(papers.find(p=>p.id===id).order).padStart(2,'0');
const article=id=>base+lang+'/papers/'+id+'/';
---
<Layout lang={lang} title={c.id+' · '+c.title[lang]} otherPath={(en?'ja':'en')+'/catalog/'+c.id+'/'}>
 <nav class="breadcrumbs" aria-label={en?'Breadcrumb':'現在位置'}><a href={base+lang+'/'}>{en?'Fields':'分野一覧'}</a>{relatedFields.map(f=><><span aria-hidden="true">/</span><a href={base+lang+'/fields/'+f.id+'/'}>{f.title[lang]}</a></>)}<span aria-hidden="true">/</span><span aria-current="page">{c.id}</span></nav>
 <header class="family-header catalog-intro"><p class="eyebrow">CATALOGUE {c.id}</p><h1>{c.titlePhrases?.[lang] ? c.titlePhrases[lang].map(phrase=><span class="title-phrase">{phrase}</span>) : c.title[lang]}</h1>{!en&&<p class="official" lang="en">{c.title.en}</p>}<p class="lede">{en?'From a first section to a good model, and from a good model to a uniform Iitaka degree. Follow the claims of 14 manuscripts and the results their arguments use.':'最初の切断から良いモデルへ、良いモデルから一様な飯高次数へ。14本の論文が主張する結果と、その議論を支える入力をたどります。'}</p></header>
 {pdf&&<aside class="catalog-pdf" aria-label={en?'PDF edition':'PDF版'}><a href={base+'pdf/'+pdf.file} target="_blank" rel="noopener noreferrer">{en?'Read the synthesis + all 14 overviews as a PDF':'総括＋全14篇の解説をPDFで読む'} ↗</a><p>{en?'English':'日本語'} · {pdf.pages}{en?' pages':'ページ'} · {(pdf.bytes/1048576).toFixed(1)} MB · {pdf.date}{en?' edition':'版'}<br/>{en?'Includes a linked contents page, proof diagrams, and source references.':'目次・証明図・原典へのリンク付き。'}</p></aside>}
 <div class="catalog-stats"><span><strong>{orderedPapers.length}</strong>{en?'manuscript summaries':'篇の要点整理'}</span><span><strong>{catalogueDependencies.length}</strong>{en?'selected connections':'件の主な接続'}</span><span><strong>{orderedPapers.filter(p=>p.featured).length}</strong>{en?'proof overviews':'篇の証明概説'}</span></div>
 <p class="catalog-reading-note">{en?'This is a reading map of the manuscripts’ claims and uses of cited results. The arrows record selected source-to-use connections; they are not a complete dependency graph or a certification of the proofs.':'原稿の主張と引用の使い方を整理した、読解の見取り図です。矢印は原典の記述と使用箇所を照合した接続を示します。依存関係の網羅や、証明全体の正しさの認定ではありません。'}</p>
 <nav class="catalog-nav" aria-label={en?'On this page':'このページの内容'}><a href="#manuscripts">{en?'All 14 manuscripts':'全14篇の要点'}</a><a href="#overview">{en?'Three strands':'3つの流れ'}</a><a href="#dependencies">{en?'Follow dependencies':'依存関係をたどる'}</a><a href="#external-inputs">{en?'Inputs outside 034':'034の外からの入力'}</a><a href="#reading-scope">{en?'Reading scope':'確認範囲'}</a></nav>
 <section id="manuscripts" class="paper-section">
  <h2>{en?'All 14 manuscripts, in official order':'全14篇の要点（公式カタログ順）'}</h2>
  <p class="article-prose">{en?'The summaries give the principal scope, not every technical hypothesis. Follow the theorem reference for the full statement. A uniform degree here is an existence statement unless a manuscript explicitly gives a numerical value.':'主結果の範囲を短くまとめています。技術的な仮定をすべて再掲しているわけではないため、正確な定式化は併記した原典の定理を参照してください。一様な次数の存在と、具体的な数値の提示は区別します。'}</p>
  <p class="table-hint">{en?'Page counts include references. On narrow screens, scroll the table sideways.':'ページ数は参考文献を含みます。狭い画面では表を横にスクロールできます。'}</p>
  <div class="digest-table-wrap" role="region" aria-label={en?'Manuscript inventory and roles':'論文一覧と役割'} tabindex="0"><table class="digest-table catalog-inventory">
   <caption>{en?'Catalogue 034 · Pinned source snapshot checked on 8 October 2026':'カタログ034 · 2026年10月8日確認の固定参照版'}</caption>
   <thead><tr><th scope="col">#</th><th scope="col">{en?'Manuscript and overview':'論文・概説'}</th><th scope="col">{en?'Principal claim':'主に何を主張するか'}</th><th scope="col">{en?'Role and available overview':'議論の役割・概説'}</th></tr></thead>
   <tbody>{orderedPapers.map(p=>{const n=notesById[p.id];return <tr id={'paper-'+p.id} class:list={{'featured-row':p.featured}}>
    <td>{number(p.id)}</td><th scope="row"><a class="manuscript-title" href={p.featured?article(p.id):paperSource(p)} lang="en">{p.title}<span aria-hidden="true"> {p.featured?'→':'↗'}</span></a><span class="table-detail">{en?'Short name':'図中の略称'}: {n.short}</span><span class="table-detail">{p.version} · {p.pages} {en?'pages':'ページ'}</span><a class="manuscript-source" href={paperSource(p)}>{en?'Original paper (GitHub)':'原論文（GitHub）'} ↗</a></th>
    <td><p>{n.claim[lang]}</p><a class="claim-source" href={paperSource(p)}>{n.result} ↗</a></td>
    <td><p>{n.role[lang]}</p>{p.featured?<a class="overview-link" href={article(p.id)}>{en?'Read the proof overview':'証明概説を読む'} →</a>:<span class="badge">{en?'Summary · No separate article yet':'要点整理・個別記事なし'}</span>}</td>
   </tr>;})}</tbody>
  </table></div>
 </section>
 <section id="overview" class="paper-section">
  <h2>{en?'Three strands of the argument':'議論をつなぐ3つの流れ'}</h2>
  <p class="article-prose">{en?'These are reading groups for this guide. The numbered manuscript inventory above retains the official catalogue order. Short names used in diagrams are paired with the full titles there.':'ここでは議論の役割で3つに分けます。上の全論文一覧は公式カタログ順を維持しています。図で使う略称と正式タイトルも一覧で対応させています。'}</p>
  <div class="catalog-themes">{themes.map((theme,i)=><article class="catalog-theme"><p class="eyebrow">0{i+1}</p><h3><a href={'#strand-'+theme.id}>{theme.title[lang]} ↓</a></h3><p class="theme-aim">{theme.question[lang]}</p><p>{theme.body[lang]}</p><ul>{catalogueNotes.filter(n=>n.theme===theme.id).map(n=><li><span>{number(n.id)}</span><a href={article(n.id)}>{n.short}</a></li>)}</ul></article>)}</div>
  <aside class="catalog-crossings"><strong>{en?'The connection between the strands':'3つの流れの接続点'}</strong><p>{en?'LA supplies qualitative good models to Schnell and to the effective-degree papers. The fourfold route combines nonvanishing, lifting and relative denominators. In the Kähler strand, projective good models become an anchor for analytic induction; its subadditivity and MMP premises remain visible.':'LAはSchnellと有効飯高の論文群に、定性的な良いモデルを供給します。四次元の経路では、非消滅・持ち上げ・相対分母が合流します。Kählerの経路では射影的な良いモデルが解析的帰納法の足場となり、劣加法性やMMPの前提を保持して進みます。'}</p></aside>
 </section>
 {synthesis.map(strand=><section id={'strand-'+strand.id} class="paper-section catalog-strand">
  <h2>{strand.title[lang]}</h2><p class="article-prose">{strand.intro[lang]}</p>
  <ProofDiagram proof={strand} lang={lang} collection="catalog-034"/>
  <div class="article-prose proof-explanation">{strand.steps.map((step,i)=><section class="proof-step">
   <h3>{i+1}. {step.title[lang]}</h3><p>{step.body[lang]}</p>
   <div class="catalog-step-links"><span>{en?'Connection details':'接続の根拠'}:</span>{step.edges.map(id=>{const d=catalogueDependencies.find(d=>d.id===id);return <a href={'#connection-'+id}>{notesById[d.fromId].short} → {notesById[d.toId].short} · {d.result.split(' · ')[0]}</a>;})}</div>
   <p class="source-line">{step.read.map(([id,anchor])=><a href={article(id)+'#'+anchor}>{notesById[id].short} · {en?'Proof overview':'証明概説'} →</a>)}</p>
  </section>)}</div>
 </section>)}
 <section id="dependencies" class="paper-section">
  <h2>{en?'Follow a result into its application':'どの結果を、どこで使うのか'}</h2>
  <p class="article-prose screen-only">{en?'The diagrams select principal routes. This explorer includes the other recorded connections. Choose a manuscript and direction, or follow an arrow above to open its result-level record. The initial view shows the three inputs recorded for Log Iitaka.':'全体図には主要経路を選んで載せています。ここでは図で省略した接続も確認できます。論文と方向を選ぶか、上の矢印から対応する記録を開いてください。最初はLog Iitakaへの3つの入力を表示しています。'}</p>
  <p class="print-only">{en?'The following records include all 23 selected connections. Each gives the supplied result, its use, and the scope of the editorial check.':'以下に記録した23件の接続を収録します。それぞれ供給する結果・利用先・確認範囲を示しています。'}</p>
  <CatalogDependencies lang={lang}/>
  <p class="catalog-reading-note">{en?'Read dependencies at the level of results: Fourfold nonvanishing uses LA’s independent geometric tools and Frobenius theorem. Its abundance main theorem is not that input. In Supported lifting, fourfold nonvanishing enters Corollary 1.4; Theorem 1.2 already assumes a first section. These distinctions matter when tracing apparent back-and-forth citations.':'依存は結果の単位で読みます。Fourfold nonvanishingが使うLAの入力は独立した幾何的補題とFrobenius定理です。また、Supported liftingに四次元非消滅が入るのはCorollary 1.4であり、Theorem 1.2は最初の切断を仮定する段階です。相互の引用をたどるときも、どの結果がどの証明へ入るかを区別します。'}</p>
  <span id="dependency-canonical-good-model"></span>
  <details class="catalog-audit"><summary>{en?`View all ${catalogueDependencies.length} recorded connections as a table`:`記録した${catalogueDependencies.length}件の接続を表で見る`}</summary><DependencyTable lang={lang} entries={catalogueDependencies} caption={en?'Selected direct inputs within catalogue 034':'034内で記録した主な直接入力'}/></details>
 </section>
 <section id="external-inputs" class="paper-section">
  <h2>{en?'Inputs from outside catalogue 034':'034の外から入る結果'}</h2>
  <div class="catalog-external">
   <div><h3>{en?'033 → LA: subadditivity':'033 → LA：劣加法性'}</h3><p>{en?'LA’s Lemma 6.1 uses Corollary 6.2 of the orbifold Iitaka manuscript in catalogue 033, in its zero-boundary projective case. The LA overview also explains how the existing Hacon–Popa–Schnell result supplies this particular application.':'LAのLemma 6.1では、033のorbifold飯高原稿のCorollary 6.2を境界0・射影の場合に使います。LA概説では、この適用を既存のHacon–Popa–Schnellの結果で賄えることも説明しています。'}</p><a href={article('log-abundance-characteristic-zero')+'#connections'}>{en?'See the statements and application in LA':'LAでの記述と適用を見る'} →</a></div>
   <div><h3>{en?'033 / 056 → conditional Kähler models':'033 / 056 → 条件付きKählerモデル'}</h3><p>{en?'The receiving manuscript identifies orbifold subadditivity and the specified Kähler MMP as Assumptions 2.2–2.3. Together with abundance after nonvanishing from 034, they form its three premises. The companion statements and selected application conditions are compared in the conditional Kähler overview. The complete proofs of the premises have not been independently verified.':'利用先の原稿は、orbifold劣加法性と指定されたKähler MMPをAssumptions 2.2–2.3に挙げています。034の非消滅後の豊富性と合わせた3つの前提です。033・056の原定理と主要な適用条件は条件付きKähler概説で照合しました。前提の証明全体を独立検証したものではありません。'}</p><a href={paperSource(papers.find(p=>p.id==='conditional-kahler-fourfolds'))}>Assumptions 2.2–2.4 · pp. 7–9 ↗</a> <a href={article('conditional-kahler-fourfolds')}>{en?'Read the conditional overview':'条件付き概説を読む'} →</a></div>
  </div>
  <p class="catalog-reading-note">{en?'Established inputs such as Hashizume’s reduction, gluing, lower-dimensional abundance, and effective birationality are not exhaustively mapped here. The individual articles identify their selected external inputs separately. The all-dimensional Kähler article also records Hodge-line, relative Iitaka and weak-effectivity inputs from OILS, outside the 14-paper inventory.':'Hashizumeの帰着、貼り合わせ、低次元の豊富性、有効双有理性など、既存文献からの入力はここでは網羅していません。各概説で、選んだ外部入力を別に記録しています。全次元のKähler記事では、この14篇の外にあるOILSからのHodge line・相対飯高・weak effectivityの入力も扱います。'}</p>
 </section>
 <section id="reading-scope" class="paper-section catalog-scope">
  <h2>{en?'What this map checks':'この見取り図の確認範囲'}</h2>
  <ul>
   <li>{en?'Read the principal statements of all 14 manuscripts and selected proof passages where results are imported. For the recorded arrows, compared the supplied statement with the receiving connection. This does not verify the complete source or receiving proof.':'全14篇の主要結果と、選んだ入力を使う証明箇所を読みました。記録した矢印について、供給する結果の記述と利用先の接続を照合しました。入力元・利用先の証明全体を検証したことは意味しません。'}</li>
   <li>{en?'Manuscripts with a separate proof overview are marked in the inventory above. Each article records its reading scope and unchecked passages; the full proofs and unlisted connections are not certified. No recorded arrow does not mean no dependency.':'個別の証明概説がある論文は上の一覧に明示しています。確認範囲と未確認箇所は各記事に記録し、証明全体や未掲載の接続を検証済みとは扱いません。矢印がないことは「依存なし」を意味しません。'}</li>
   <li>{en?'Background references are kept separate from proof inputs. For example, Kähler after nonvanishing (p. 6) treats projective lifting and LA as background while proving its analytic boundary argument internally. The conditional Kähler manuscript retains its three stated premises.':'背景の引用と証明の入力を分けています。例えばKähler after nonvanishing（p. 6）は、射影的な持ち上げとLAを背景として挙げ、解析的境界の議論は原稿内で行います。条件付きKählerモデルの3仮定も表示から落としていません。'}</li>
   <li>{en?'All 14 PDF hashes match the recorded source snapshot. This page refers to the commit below, checked on 8 October 2026, and does not incorporate subsequent revisions. Expert review and formal verification have not been performed.':'全14PDFのハッシュが記録済みの参照版と一致することを確認しました。以下のcommitを2026年10月8日に参照しており、その後の改訂は反映していません。専門家査読・形式検証は未実施です。'}</li>
  </ul>
 </section>
 <p class="source-note"><a href={officialOverview+'#page=5'} target="_blank" rel="noopener noreferrer">OpenAI Research Catalog · 034 · p. 5 ↗</a><br/><a href={officialCatalog}>{en?'Official catalogue at the reference commit':'参照commitの公式カタログ'} ↗</a><br/><span class="small">CONTENTS.md: <span lang="en">{c.contentsTitle}</span></span><br/><span class="small muted">{en?'Source snapshot':'参照版'}: <code>{sourceCommit}</code></span></p>
</Layout>
