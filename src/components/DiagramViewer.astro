---
const {lang='ja'}=Astro.props;
const en=lang==='en';
---
<dialog class="diagram-viewer" aria-labelledby="diagram-viewer-title">
 <div class="diagram-viewer-bar">
  <h2 id="diagram-viewer-title">{en?'Enlarged figure':'図の拡大表示'}</h2>
  <button type="button" data-close autofocus>{en?'Close':'閉じる'} ×</button>
 </div>
 <div class="diagram-viewer-controls" aria-label={en?'Zoom controls':'拡大率の操作'}>
  <button type="button" data-zoom="out" aria-label={en?'Zoom out':'縮小'}>−</button>
  <output aria-live="polite"></output>
  <button type="button" data-zoom="in" aria-label={en?'Zoom in':'拡大'}>＋</button>
  <button type="button" data-fit>{en?'Fit whole figure':'全体を表示'}</button>
 </div>
 <p class="diagram-viewer-hint">{en?'Scroll to move around the figure. Underlined citations remain clickable.':'スクロールして図を移動できます。下線の引用リンクも利用できます。'}</p>
 <div class="diagram-viewer-scroll" tabindex="0" role="region" aria-label={en?'Enlarged diagram, scroll to explore':'拡大した図。スクロールして移動'}>
  <div class="diagram-viewer-canvas"></div>
 </div>
</dialog>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('.diagram-viewer')!;
 const canvas=dialog.querySelector<HTMLElement>('.diagram-viewer-canvas')!;
 const scroller=dialog.querySelector<HTMLElement>('.diagram-viewer-scroll')!;
 const output=dialog.querySelector('output')!;
 const minus=dialog.querySelector<HTMLButtonElement>('[data-zoom="out"]')!;
 const plus=dialog.querySelector<HTMLButtonElement>('[data-zoom="in"]')!;
 let origin:HTMLElement|null=null, width=1000, serial=0, previousOverflow='';
 const minimum=()=>Math.min(320,scroller.clientWidth);
 function setWidth(value:number,center=true){
  const old=width, x=(scroller.scrollLeft+scroller.clientWidth/2)/old;
  const y=(scroller.scrollTop+scroller.clientHeight/2)/old;
  width=Math.max(minimum(),Math.min(3000,value));
  canvas.style.width=width+'px';
  output.value=Math.round(width/10)+'%';
  minus.disabled=width<=minimum();plus.disabled=width>=3000;
  if(center){scroller.scrollLeft=x*width-scroller.clientWidth/2;scroller.scrollTop=y*width-scroller.clientHeight/2;}
 }
 function openFigure(figure:Element,trigger:HTMLElement){
  const source=figure.querySelector('.proof-diagram svg');
  if(!source||dialog.open)return;
  const svg=source.cloneNode(true) as SVGSVGElement;
  // A second inline copy must have its own glyph, clip and accessibility IDs.
  const ids=new Map<string,string>();
  const elements=[svg,...svg.querySelectorAll('*')];
  for(const node of elements)if(node.id)ids.set(node.id,`viewer-${++serial}-${node.id}`);
  for(const node of elements){
   for(const attr of Array.from(node.attributes)){
    let value=attr.value;
    if(attr.name==='id')value=ids.get(value)!;
    else if(['href','xlink:href'].includes(attr.name)&&value.startsWith('#')&&ids.has(value.slice(1)))value='#'+ids.get(value.slice(1));
    else if(['aria-labelledby','aria-describedby'].includes(attr.name))value=value.split(/\s+/).map(id=>ids.get(id)||id).join(' ');
    else value=value.replace(/url\(#([^)]+)\)/g,(match,id)=>ids.has(id)?`url(#${ids.get(id)})`:match);
    if(value!==attr.value)node.setAttributeNS(attr.namespaceURI,attr.name,value);
   }
  }
  canvas.replaceChildren(svg);origin=trigger;
  previousOverflow=document.documentElement.style.overflow;
  document.documentElement.style.overflow='hidden';
  dialog.showModal();setWidth(1000,false);scroller.scrollTo(0,0);
 }
 dialog.querySelector('[data-close]')!.addEventListener('click',()=>dialog.close());
 dialog.addEventListener('close',()=>{
  document.documentElement.style.overflow=previousOverflow;
  canvas.replaceChildren();origin?.focus({preventScroll:true});
 });
 dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
 minus.addEventListener('click',()=>setWidth(width/1.3));
 plus.addEventListener('click',()=>setWidth(width*1.3));
 dialog.querySelector('[data-fit]')!.addEventListener('click',()=>{setWidth(scroller.clientWidth,false);scroller.scrollTo(0,0);});
 canvas.addEventListener('click',event=>{
  // Close before the existing citation navigation/anchor filtering runs.
  if((event.target as Element).closest('a'))dialog.close();
 });
 for(const figure of document.querySelectorAll('.proof-figure')){
  const diagram=figure.querySelector<HTMLElement>('.proof-diagram');
  const link=figure.querySelector<HTMLAnchorElement>('.diagram-tools a[href$=".svg"]');
  if(!diagram||!link)continue;
  diagram.style.cursor='zoom-in';
  link.setAttribute('aria-haspopup','dialog');
  link.addEventListener('click',event=>{
   if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
   event.preventDefault();openFigure(figure,link);
  });
  diagram.addEventListener('click',event=>{
   if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
   // On phones the fitted citations are too small to target: open the readable copy.
   if((event.target as Element).closest('a')&&!matchMedia('(max-width:700px)').matches)return;
   event.preventDefault();openFigure(figure,diagram);
  });
  diagram.addEventListener('keydown',event=>{
   if(event.target===diagram&&(event.key==='Enter'||event.key===' ')){
    event.preventDefault();openFigure(figure,diagram);
   }
  });
 }
</script>
<style is:global>
 .diagram-viewer{box-sizing:border-box;width:calc(100% - 24px);max-width:1440px;height:calc(100dvh - 24px);max-height:calc(100dvh - 24px);margin:auto;padding:16px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);font:16px/1.5 -apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif}
 .diagram-viewer[open]{display:flex;flex-direction:column;gap:10px}
 .diagram-viewer::backdrop{background:rgb(20 32 28 / .7)}
 .diagram-viewer-bar,.diagram-viewer-controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
 .diagram-viewer-bar{justify-content:space-between}
 .diagram-viewer-bar h2{margin:0;font:600 18px/1.5 -apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif}
 .diagram-viewer button{min-height:44px;min-width:44px;padding:8px 12px;border:1px solid #9ba99f;border-radius:4px;background:#edf0e8;color:#24342d;font:inherit;cursor:pointer}
 .diagram-viewer button:disabled{opacity:.4;cursor:default}
 .diagram-viewer button:focus-visible,.diagram-viewer-scroll:focus-visible{outline:3px solid var(--link);outline-offset:2px}
 .diagram-viewer output{min-width:52px;text-align:center;font-variant-numeric:tabular-nums}
 .diagram-viewer-hint{margin:0;font-size:14px}
 .diagram-viewer-scroll{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;border:1px solid var(--line);background:#fff}
 .diagram-viewer-canvas{margin:auto}
 .diagram-viewer-canvas svg{display:block;width:100%;max-width:none;min-width:0;height:auto}
 .diagram-viewer-canvas svg a{cursor:pointer}
 @media(max-width:700px){.diagram-viewer{padding:10px}.diagram-viewer-bar h2{font-size:16px}.diagram-viewer-controls{gap:6px}}
 @media print{.diagram-viewer{display:none!important}}
</style>
