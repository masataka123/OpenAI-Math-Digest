---
const assets=import.meta.glob('../../public/diagrams/*.svg',{query:'?raw',import:'default',eager:true});
const {proof,lang,collection='schnell'}=Astro.props;
const en=lang==='en', base=import.meta.env.BASE_URL;
const stem=collection+'-'+proof.diagram+(en?'-en':'');
const svg=assets['../../public/diagrams/'+stem+'.svg'].replace(/(<title[^>]*>)[\s\S]*?(<\/title>)/,(_,a,b)=>a+proof.alt[lang]+b);
---
<figure class="proof-figure" aria-labelledby={'caption-'+proof.diagram}>
 <div class="proof-diagram" tabindex="0" role="region" aria-label={proof.alt[lang]}><Fragment set:html={svg}/></div>
 <figcaption id={'caption-'+proof.diagram}>{proof.caption[lang]}</figcaption>
 <div class="diagram-tools"><span>{collection==='la'?(en?'Arrow notes state what is used. Citations open the sources; this manuscript opens on GitHub. Scroll sideways on narrow screens.':'矢印には引用から使う内容を記しています。本原稿へのリンクはGitHubで開きます。狭い画面では横にスクロールできます。'):en?'Arrow notes state what is used; underlined citations open the source ([LA] on GitHub). Scroll sideways on narrow screens.':'矢印の説明は「引用元から使う内容」です。下線の引用から原典を参照できます（[LA]はGitHub）。狭い画面では横にスクロールできます。'}</span><a href={base+'diagrams/'+stem+'.svg'} target="_blank" rel="noopener noreferrer">{en?'Open figure':'図を拡大'} ↗</a><a href={base+'diagrams/'+stem+'.tex'} download>{en?'TeX source':'TeXソース'} ↓</a></div>
</figure>
