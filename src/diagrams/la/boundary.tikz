\begin{tikzpicture}
\node[card] (start) {\heading{START}{符号付き境界の判定を準備する}{Prepare the signed-boundary criterion}
$L=K_X+D\ \text{nef},\quad L-cD\in\Eff(X),\quad c>0,$\\[3pt]
$L\sim_{\mathbb Q}\sum a_iD_i,\quad D=\sum D_i\ \text{reduced},\quad L|_D\ \text{semiample}.$\\[3pt]
\Tx{以下 $n=\dim X$, $0<v=\nu(L)<n$。}{Below, $n=\dim X$ and $0<v=\nu(L)<n$.}};
\node[card,below=1.9cm of start] (positive) {\heading{01}{正係数の境界成分を、他の符号の成分から分離する}{Separate a positive component from the negative and zero parts}
\Tx{半豊富な像の次元は $v-1$。その一般点上で根構成を行う。}{Its semiample image has dimension $v-1$; take roots over a general point.}};
\flow{start}{positive}{\Tx{混合交点数で正成分の像の次元を決定し、他の符号との交わりを避ける。\\境界全体の半豊富性は、帰納法と conductor に沿う貼り合わせから得る。}{Mixed intersections locate the positive image away from the other signs.\\Induction and conductor gluing supply semiampleness on the entire boundary.}\\[4pt]\LA{13}{Lemma 3.2}\quad\LA{14}{Prop. 3.3}\quad\LA{8}{Prop. 2.3}\quad\FGglue{2}{[FG14] Thm. 1.5}}
\node[card,below=1.95cm of positive] (formal) {\heading{02}{像の座標と横断座標を、全ての無限小近傍へ持ち上げる}{Lift image coordinates and a transverse coordinate to every thickening}
\Tx{基底方向を固定しつつ、境界から外へ動かす形式的変形。}{A formal deformation that holds the base directions fixed and moves off the boundary.}};
\flow{positive}{formal}{\Tx{障害を Hodge 加群の最低フィルター部分に置く。\\symbol map の核に入る障害を、負の捻りの消滅で取り除く。}{Place obstructions in the lowest Hodge piece. Negative-twist vanishing\\kills the obstruction in the symbol-map kernel.}\\[4pt]\LA{19}{Prop. 4.1}\quad\LA{19}{Lemma 4.2}\quad\LA{21}{Lemma 4.3}}
\node[card,below=1.7cm of formal] (compact) {\heading{03}{境界の外に、完備な $L$-trivial 部分多様体の族を得る}{Obtain compact $L$-trivial subvarieties off the boundary}
$\dim F=n-v,\qquad F\cap D=\varnothing,\qquad L|_F\equiv0.$\\[3pt]\Tx{これらの族が $X$ を支配する。}{These subvarieties form a dominating family on $X$.}};
\flow{formal}{compact}{\Tx{一般境界ファイバーの形式的変形を Grothendieck existence で代数化。}{Algebraize the formal boundary-fiber deformation by Grothendieck existence.}\\[4pt]\LA{26}{Prop. 5.1, pp. 26--28}}
\node[card,below=1.9cm of compact] (descent) {\heading{04}{nef reduction の底へ、符号付き因子を降ろす}{Descend the signed divisor to the nef-reduction base}
$\pi^*L\sim_{\mathbb Q}f^*G_B,\qquad G_B\ \text{nef},\qquad \dim B=b.$};
\flow{compact}{descent}{\Tx{$F$ は nef reduction に収縮され、$b\leq v$。$L-cD$ の擬有効性から\\境界は垂直となり、垂直な nef 因子の降下補題を適用する。}{The nef reduction contracts $F$, so $b\leq v$. Pseudo-effectivity of $L-cD$\\makes the boundary vertical; apply vertical nef-divisor descent.}\\[4pt]\LA{28}{Lemma 5.2}\quad\LA{29}{$\S5.1$, pp. 29--30}}
\node[result,below=1.8cm of descent] (end) {\heading{END}{底の因子は big。切断を引き戻して abundance を得る}{The base divisor is big; pull back its sections to obtain abundance}
$v=\nu(G_B)\leq b\leq v\quad\Longrightarrow\quad \kappa(L)=\nu(L).$\\[3pt]\textbf{Theorem 3.1}};
\flow{descent}{end}{\Tx{底の次元と数値次元が一致するため $G_B$ は big。\\$\kappa(L)\geq v$ と、nef 因子の一般不等式 $\kappa(L)\leq\nu(L)$ を合わせる。}{The base dimension equals the numerical dimension, so $G_B$ is big.\\Combine $\kappa(L)\geq v$ with the nef inequality $\kappa(L)\leq\nu(L)$.}\\[4pt]\LA{30}{Thm. 3.1, end of proof}}
\end{tikzpicture}
