\begin{tikzpicture}
\node[card] (relative) at (0,0) {\Head{11\quad 相対的な分母を抑える}{11\quad Bound relative denominators}
\Paper{relative-denominators}{Relative denominators}\\[4pt]
\Tx{全空間の次元 $\le4$。\\moduli分母とbigな底の線形系。}{Total dimension $\le4$.\\Moduli denominators and systems on a big base.}};
\node[card] (stein) at (10,0) {\Head{12\quad 定数体拡大を抑える}{12\quad Bound constant-field extensions}
\Paper{arithmetic-stein-degree}{Stein degree}\\[4pt]
\Tx{境界成分のStein次数を\\次元と係数の下限で制御。}{Control boundary Stein degrees\\by dimension and a coefficient lower bound.}};
\node[card] (la) at (20,0) {\Head{04\quad 定性的なモデルの入力}{04\quad Qualitative model input}
\Paper{log-abundance-characteristic-zero}{LA: Theorem 11.1}\\[4pt]
\Tx{有効性を調べるため、良いモデルへ移る。}{Pass to a good model before studying effectivity.}};
\node[result] (fourfold) at (0,-6.6) {\Head{13\quad 四次元の有効飯高}{13\quad Effective fourfold Iitaka}
\Paper{effective-log-iitaka-fourfolds}{Fourfold Iitaka}\\[4pt]
\Tx{四次元の指数・飯高次数。\\別に、任意次元の鎖の補題を収録。}{Fourfold indices and Iitaka degrees.\\Also contains dimension-free chain lemmas.}};
\Flow{relative}{fourfold}{edge}{\Tx{moduli分母と、底の全関数体を\\生成する一様次数を供給。}{Supplies moduli denominators and\\a uniform degree generating the base field.}\\[4pt]\Input{relative-fourfold-iitaka}{Thm. 1.1 / Prop. 6.1}}
\node[result] (uniform) at (10,-6.6) {\Head{10\quad 指数と次数の同時帰納}{10\quad Induct on indices and degrees}
\Paper{uniform-pluricanonical-iitaka}{Uniform Iitaka}\\[4pt]
\Tx{normal lc指数と、滑らかな射影\\多様体の飯高次数を一様化。}{Uniform normal lc indices and Iitaka\\degrees for smooth projective varieties.}};
\Flow{stein}{uniform}{edge}{\Tx{境界のStein次数を抑え、\\ノルムによる指数の降下を制御。}{Bounds the boundary Stein degree;\\controls index descent by norms.}\\[4pt]\Input{stein-uniform}{Theorem 1.1}}
\draw[auxiliary] (fourfold.east)--(uniform.west);
\node[reason,text width=3cm,anchor=south] at (5,-6.3) {\Tx{被覆族の鎖から\\葉の評価を得る。}{Chains of families\\give leaf estimates.}\\[4pt]\Input{fourfold-uniform-tool}{\S5: chain lemmas}};
\node[result] (log) at (20,-6.6) {\Head{09\quad log飯高へ進む}{09\quad Pass to log Iitaka}
\Paper{uniform-log-iitaka}{Log Iitaka}\\[4pt]
\Tx{有限有理係数のlc対。\\一様次数で飯高関数体全体を得る。}{Lc pairs with finite rational coefficients.\\A uniform degree gives the full Iitaka field.}};
\Flow{la}{log}{edge}{\Tx{semiampleなモデルを供給。\\次数の一様性は利用先で示す。}{Supplies the semiample model.\\The receiving argument bounds the degree.}\\[4pt]\Input{la-log}{Theorem 11.1}}
\draw[edge] (uniform.east)--(log.west);
\node[reason,text width=3cm,anchor=south] at (15,-6.3) {\Tx{一般ファイバーを\\一様次数で自明化。}{Trivialize the generic\\fibre uniformly.}\\[4pt]\Input{uniform-log}{Theorem 1.2}};
\node[result] (slc) at (20,-13.2) {\Head{02\quad conductorを越えて貼る}{02\quad Glue across the conductor}
\Paper{uniform-slc-indices}{slc indices}\\[4pt]
\Tx{正規化成分の自明化に\\指標・留数・閉路の制御を加える。}{Add character, residue and cycle control\\to normalization trivializations.}};
\Flow{log}{slc}{auxiliary}{\Tx{積被覆と、追加quasi-étale被覆\\に対する安定性を供給。}{Supplies product covers and stability\\under further quasi-étale covers.}\\[4pt]\Input{log-iitaka-slc-product}{Prop. 5.1 / Lemmas 5.2--5.3}}
\draw[edge] (uniform.south)--(10,-13.2)--(slc.west);
\node[reason,text width=5.2cm,anchor=south] at (13.1,-12.75) {\Tx{正規化の各lc成分を\\共通の次数で自明化する。}{Trivializes every lc normalization\\component in a common degree.}\\[4pt]\Input{uniform-slc}{Theorem 1.2}};
\end{tikzpicture}
