---
import WorkerCArticle from '../../../components/WorkerCArticle.astro';
import CatalogDraftArticle from '../../../components/CatalogDraftArticle.astro';
import SchnellArticle from '../../../components/SchnellArticle.astro';
import LogAbundanceArticle from '../../../components/LogAbundanceArticle.astro';
import {papers,languages} from '../../../data/site.mjs';
export function getStaticPaths(){return languages.flatMap(lang=>papers.filter(p=>p.featured).map(paper=>({params:{lang,id:paper.id},props:{paper}})));}
const {paper}=Astro.props, lang=Astro.params.lang;
---
{['minimal-metrics-injectivity','fourfold-nonvanishing','uniform-slc-indices','conditional-kahler-fourfolds'].includes(paper.id)?<WorkerCArticle paper={paper} lang={lang}/>:!['log-abundance-characteristic-zero','schnell-fiber-spaces'].includes(paper.id)?<CatalogDraftArticle paper={paper} lang={lang}/>:paper.id==='log-abundance-characteristic-zero'?<LogAbundanceArticle paper={paper} lang={lang}/>:<SchnellArticle paper={paper} lang={lang}/>}
