\flow{absolute}{return}{\Tx{受動・能動の復帰後、合同条件と実数条件を解く}{Passive/active return, then solve modular and real constraints}\\\Cite{return}\quad\Cite{extract}};
\node[result,below=2.15cm of return] (new) {\heading{5}{三角型損失を持つ次の証明書}{Next certificate with triangular losses}
$a'=(1+\eta_k)a,\qquad Q_i'-Q_i\le P_i(p,d_*,Q_{>i})$\\
