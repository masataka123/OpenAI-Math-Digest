\node[card,below=2.15cm of cert] (path) {\heading{2}{準備して末端箱へ進む}{Prepare and descend to terminal boxes}
$\mathbb EY\ge(1-\delta)a,\qquad\Pr(Y\ge(1-2\delta)a)\ge\delta a$\\
\Tx{rank cut と単射な整数アフィン経路}{Rank cuts and injective integer-affine paths}};
\flow{cert}{path}{\Tx{旧整数引数を正確に変換。停止経路は質量ゼロにする}{Transform old integer arguments exactly; stopped paths have zero mass}\\\Cite{prepare}\quad\Cite{forward}};
\node[card,below=2.15cm of path] (absolute) {\heading{3}{絶対増分で新規座標を得る}{Obtain fresh slots by the absolute increment}
