\node[card] (a) {\heading{1}{固定曲面を含む一般完全交叉}{A general complete intersection through the surface}
$F=A\times\{0\}\subset X\subset S'\times B,\quad\dim B=6,\quad\dim X=4$\\
$\pi_1(X)\simeq\pi_1(S')\times\pi_1(B)$};
\node[card,below=2.3cm of a] (b) {\heading{2}{正次元部分多様体の無限群像}{Infinite image for positive-dimensional subvarieties}
\Tx{$Z\to B$ 非定数：コンパクト性と普遍被覆 $\mathbf C^6$}{Nonconstant $Z\to B$: compactness and universal cover $\mathbf C^6$}\\
\Tx{$Z\subset F$：$A$ の単純性と無限巡回像}{For $Z\subset F$: simplicity of $A$ and its infinite cyclic image}};
\flow{a}{b}{\Tx{四点補間と次元計算で正次元fiberを $F$ 内に制限}{Four-point interpolation forces\\positive-dimensional fibers into $F$}\\\Cite{complete-intersection}};
\node[card,below=2.3cm of b] (c) {\heading{3}{large条件と被覆成分}{Largeness and the covering component}
\Tx{$\widetilde X$ に正次元コンパクト解析部分多様体なし}{No positive-dimensional compact analytic subvariety in $\widetilde X$}\\
$K=\ker(\pi_1(A)\to\pi_1(X))\simeq\mathbf Z^3,\quad A_K=\mathbf C^2/K\subset\widetilde X$};
\flow{b}{c}{\Tx{large条件の同値と被覆分類を使う}{Use the equivalence for largeness and covering classification}\\\Cite{large}};
\node[card,below=2.7cm of c] (d) {\heading{4}{閉複素曲面の位相的障害}{Topological obstruction on a closed complex surface}
$A_K\simeq_{\mathrm{diff}}(S^1)^3\times\mathbf R,\quad H_3(A_K,\mathbf Z)=\mathbf Z$\\
\Tx{$A_K$ は非Stein $\Longrightarrow\widetilde X$ は非Stein}{Non-Stein $A_K\Longrightarrow$ non-Stein $\widetilde X$}};
\flow{c}{d}{\Tx{Stein曲面のCW次元は実2以下；閉部分多様体へ適用}{A Stein surface has CW dimension at most two;\\apply to the closed submanifold}\\\Cite{stein-obstruction}\\\Cite{milnor-input}};
\node[result,below=2.7cm of d] (e) {\heading{5}{正則凸性を否定する}{Rule out holomorphic convexity}
\Tx{もし正則凸なら、Remmert還元の全fiberは点}{If holomorphically convex, all Remmert fibers are points}\\
\Tx{$\Longrightarrow\widetilde X$ はStein：矛盾}{Then $\widetilde X$ is Stein: contradiction}};
\flow{d}{e}{\Tx{非Stein性だけでなく、正次元コンパクト解析集合の不在を使う}{Use both non-Steinness and absence of\\positive-dimensional compact analytic subsets}\\\Cite{remmert}};
