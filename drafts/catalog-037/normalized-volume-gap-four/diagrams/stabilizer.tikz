\node[card] (a) at (0,0) {\heading{1}{有限slice上の試験付値}{A test valuation on a finite slice}
 $(u,z_1,z_2,z_3):\ (1,\alpha,\alpha,\alpha)$,\quad $A_C(v_\alpha)=r+3\alpha$};
\node[card,below=1.6cm of a] (b) {\heading{2}{文字別jetを数える}{Count jets in one character}
 $\dim S_j\sim h j^3/6$,\quad $\dim(\text{jets in one character})\sim\ell^3/(6m)$\\[4pt]
 $\displaystyle\operatorname{vol}(v_\alpha)\le\frac{h}{(1+\alpha(mh)^{1/3})^3}$};
\flow{a}{b}{\Tx{滑らかなsliceの巡回作用とvaluation idealの長さ評価}{The cyclic action on the smooth slice controls valuation-ideal lengths}\\[3pt]\Cite{extraction}\quad\Cite{jets}};
\node[card,below=1.5cm of b] (c) {\heading{3}{大きいstabilizerは体積を下げる}{A large stabilizer would lower volume}
 $m/r\ge2/5\ \Longrightarrow\ Q=mhr^3\ge324/5>64$\\[5pt]
 $\displaystyle\frac{V}{r^4h}\le\frac{(1+3\delta)^4}{(1+\delta Q^{1/3})^3}\le\kappa<1$};
\flow{b}{c}{\Tx{全中心付き付値での最小性を使い、$\alpha=r\delta$とする}{Use minimality over all centered valuations and set $\alpha=r\delta$}\\[3pt]\Cite{stabilizer}};
\node[card,below=1.5cm of c] (d) {\heading{4}{最小化rayの近似と矛盾}{Contradict approximation to the minimizing ray}
 $r^4h\longrightarrow V$\quad\Tx{ゆえに}{forces}\quad $m<2r/5$};
\flow{c}{d}{\Tx{零点微分$12-3Q^{1/3}<0$で固定した$\delta$を選ぶ}{Choose a fixed $\delta$ using derivative $12-3Q^{1/3}<0$ at zero}\\[3pt]\Cite{cone}\quad\Cite{stabilizer}};
\node[result,below=1.6cm of d] (e) {\heading{5}{Cartier性で整数下界へ}{Use Cartierness for an integral lower bound}
 $A_C(F)\ge r\operatorname{ord}_F(E)\ge r/m>5/2$\\[4pt]
 $A_C(F)\in\mathbb Z\quad\Longrightarrow\quad A_C(F)\ge3$};
\flow{d}{e}{\Tx{$(\widetilde C,E)$のlc性と$mE$の局所Cartier性}{Use lc of $(\widetilde C,E)$ and local Cartierness of $mE$}\\[3pt]\Cite{extraction}\quad\Cite{stabilizer}};
