  "statements": [
    {
      "result": "Theorem 1.1",
      "pages": "1",
      "hypotheses": "ordinary projective klt Q-pair in char 0; K+B pseudo-effective; M nef Q-Cartier on X; D=K+B+M nef",
      "conclusions": [
        "semiample Q-Cartier L on X with D numerically equivalent to L"
      ],
      "checked": true
    },
    {
      "result": "Corollary 1.2",
      "pages": "2",
      "hypotheses": "ordinary projective klt Q-pair in char 0; K+B numerically trivial",
      "conclusions": [
        "every nef Q-Cartier divisor on X numerically semiample"
      ],
      "checked": true
    },
    {
      "result": "Theorem 5.1",
      "pages": "13",
      "hypotheses": "n>=2, Pj for j<n; projective Q-factorial terminal complex n-fold; K linearly trivial; L nef Cartier of full nef dimension",
      "conclusions": [
        "L big"
      ],
      "checked": true
    },
    {
      "result": "Proposition 7.1",
      "pages": "28",
      "hypotheses": "lower Pj and Theorems2.2/2.3; ordinary projective klt Q-pair complex dim n; T psef; M nef Q-Cartier; (T+aM).C>0 through sufficiently very general points for some positive rational a",
      "conclusions": [
        "T+cM big for every positive rational c"
      ],
      "checked": true
    },
    {
      "result": "Proposition 8.1",
      "pages": "30",
      "hypotheses": "ordinary projective klt Q-pair over C; K+B psef; M nef Q-Cartier",
      "conclusions": [
        "smooth projective birational w:W->X; P_sigma(w*(K+B+M)) rational and numerically equivalent to semiample Q-divisor"
      ],
      "checked": true
    }
  ],
