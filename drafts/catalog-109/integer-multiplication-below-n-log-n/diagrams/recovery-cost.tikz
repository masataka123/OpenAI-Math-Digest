\node[result] (params) {
\heading{1}{一つの固定パラメータ選択}{One fixed parameter choice}
$p=6b,\quad d=\lfloor b^\epsilon\rfloor,\quad K=\lfloor d^c\rfloor,\quad
Tp=\Theta(n)$\\
$\epsilon=2^{-75},\ c=2^{-56},\ 1-\tau=2^{-50},\
1-\lambda'=2^{-54}$\\
$\gamma=2d\alpha^2\le b/4,\qquad r=2^{\Theta(p^{1-\epsilon})}$
};
\node[card,below=2.3cm of params] (error) {
\heading{2}{disk条件を保って誤差を伝える}{Propagate errors while preserving disk conditions}
$E_s=9\,2^\gamma TL,\quad
\|\widetilde w-(u*v)/S\|<28\,2^\gamma T^2L\,2^{-p}$\\
\Tx{各phase、層、畳込み、source scaleを含む}{Includes phases, layers, convolution, and the source scale}
};
\flow{params}{error}{\Tx{縮小性と余裕を各呼出しで確認する}{Check contraction and norm margins at every call}\\[4pt]\Cite{precision}};
\node[card,below=2.3cm of error] (round) {
\heading{3}{厳密なscaleの後で係数を丸める}{Round coefficients after exact scaling}
$\times\,2^{2b+4}S:\quad
\text{\Tx{最終誤差}{final error}}<448b\,2^{-3b/4}<1/2$\\
$\Phi^{-1},\quad
c_j+k_j=d_j+2^bk_{j+1},\quad 0\le k_j<2^{2b}$
};
\flow{error}{round}{\Tx{二度目の$S$と入力scaleを戻し、carry不変量を使う}{Remove the second $S$ and input scales; use the carry invariant}\\[4pt]\Cite{recovery}};
\node[card,below=2.3cm of round] (cost) {
\heading{4}{配置・算術・前処理の全指数を比較する}{Compare all layout, arithmetic, and setup exponents}
$\min_i g_i=\epsilon c(1-\tau)=2^{-181}=2\kappa$\\
$\kappa=2^{-182},\qquad (\log p)^C\le p^\kappa
\quad\text{\Tx{（十分大）}{eventually}}$\\
\Tx{小さい余裕をさらに半分残して総費用を抑える}{Reserve half the smallest margin for the complete bound}
};
\flow{round}{cost}{\Tx{全操作を$V=Tp$で割った費用で数える}{Count every operation in time normalized by $V=Tp$}\\[4pt]\Cite{diagram-cost}};
\node[result,below=2.3cm of cost] (theorem) {
\heading{5}{一台の機械・すべての入力長}{One machine for all input lengths}
$O(Tp\,p^{1-\kappa})=O(n(\lg n)^{1-\kappa})$\\
\Tx{一つの固定閾値未満はschoolbook乗算。出力は厳密}{Use schoolbook multiplication below one fixed cutoff; output is exact}\\
\Tx{有限アルファベット・固定有限本数の一次元テープ}{Finite alphabet; a fixed finite number of one-dimensional tapes}
};
\flow{cost}{theorem}{\Tx{prime探索、descriptor、stack、入出力まで課金する}{Charge prime search, descriptors, stacks, and input/output}\\[4pt]\Cite{cost}};
