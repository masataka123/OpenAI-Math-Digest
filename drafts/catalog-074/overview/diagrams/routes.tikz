\node[branchreason,anchor=west] at (1.25,-8.3) {\Tx{正のhorizonを三つの配置の改善で排除}{Exclude positive horizon through three improvement regimes}\\[4pt]\Cite{four-reduction}\\[4pt]\Cite{four-end}};
