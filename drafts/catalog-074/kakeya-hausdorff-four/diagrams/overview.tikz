\node[card] (counter) {\heading{1}{任意集合の反例を仮定}{Assume an arbitrary-set counterexample}
$K\subset\mathbb R^4,\quad \dim_{\mathrm H}K<4-\sigma$\quad
\Tx{全方向の単位線分、可測性の仮定なし}{Unit segments in every direction; no measurability assumption}};
\node[card,below=1.75cm of counter] (critical) {\heading{2}{重み付き問題とcritical path}{Weighted problem and critical path}
$E\in\mathcal C(d),\ d<1,\ H(E)>0$
\quad $f_i(r)-f_i(0)\to d_*r,\ h(r)\to kr,\ k>0$\\[3pt]
\Tx{細さ $\log_{N_0}(q^2/J_c)$ の最適率 $\ell$ で分岐する。}{Split by optimized narrowness rate $\ell$ of $\log_{N_0}(q^2/J_c)$.}};
\flow{counter}{critical}{\Tx{外測度・有限選択から正のhorizon、次に指数を最適化}{Outer measure and finite witnesses give positive horizon; optimize exponents}\\[3pt]\Cite{reduction-diagram}\quad\Cite{critical-diagram}};
\coordinate (branchrow) at ($(critical.south)+(0,-1.6)$);
\node[card,text width=4.15cm,minimum height=3.2cm,anchor=north] (iso) at ($(branchrow)+(-5.25,0)$) {\heading{$\ell=0$}{等方的な場合}{Isotropic case}
\Tx{速度場 $\to$ potential\\conicの障害をhidden変数で補正\\二次testを復元}{Velocity field $\to$ potential\\Encode conic obstruction with the hidden coordinate\\Restore a quadratic test}\\[5pt]
$a_2=ah^{e_2},\quad e_2>0$\\[2pt]
$h\sim_{\log,N}a^k$};
\node[card,text width=4.15cm,minimum height=3.2cm,anchor=north] (finite) at (branchrow) {\heading{$0<\ell<\infty$}{有限の細さ}{Finite narrowness}
\Tx{広い射影区間、または\\horizontal model}{Wide projected intervals, or\\a horizontal model}\\
$Y'=-Z+tv$\\[3pt]
\Tx{$2k=1$：三段の切替\\$2k<1$：$u_j\downarrow2k$\\$2k\ne1$：広い区間へ}{ $2k=1$: three-leg switch\\$2k<1$: $u_j\downarrow2k$\\$2k\ne1$: return to wide intervals}};
\node[card,text width=4.15cm,minimum height=3.2cm,anchor=north] (infinite) at ($(branchrow)+(5.25,0)$) {\heading{$\ell=\infty$}{無限の細さ}{Unbounded narrowness}
\Tx{二重のtrue系\\全時間区間へ局所化\\密度比のずれを相殺\\scalar射影}{Two nested true systems\\Full-time localization\\Cancel density shifts in ratios\\Scalar projection}\\[5pt]
\Tx{固定深さで時間指数 $\to0$}{Time exponent $\to0$ at fixed depth}};
\coordinate (split) at ($(critical.south)+(0,-.55)$);
\draw[wire] (critical.south)--(split);
\draw[edge] (split)-|(iso.north);
\draw[edge] (split)--(finite.north);
\draw[edge] (split)-|(infinite.north);
\node[card,below=2cm of finite] (recover) {\heading{3}{元尺度のatlasとして回収}{Recover an atlas at the original resolution}
\Tx{有限 $\ell$：全substantial residualの候補をgreedyに覆い、一覧を回収する。\\無限 $\ell$：全時間正規化後に被覆と一覧を回収する。}{Finite $\ell$: greedily cover substantial residuals and recover finite lists.\\Infinite $\ell$: recover coverage and lists after full-time normalization.}\\[4pt]
\Tx{元の観測 $p_L$ からラベルを復元；元尺度 $N_0$ でsubpower損失}{Labels recoverable from original $p_L$; subpower losses in original $N_0$}};
\coordinate (iso-out) at ($(iso.south)+(-2.1,0)$);
\coordinate (iso-in) at ($(recover.north)+(-7.35,0)$);
\draw[edge] (iso-out)--(iso-in);
\node[reason,text width=3.8cm,anchor=west,font=\fontsize{8.5}{11}\selectfont] at ($(iso-out)!.5!(iso-in)+(.3,0)$) {\Tx{二次近似を改善}{Improve the quadratic fit}\\[3pt]\Cite{iso-branch}};
\coordinate (finite-out) at ($(finite.south)+(-2.1,0)$);
\coordinate (finite-in) at ($(recover.north)+(-2.1,0)$);
\draw[edge] (finite-out)--(finite-in);
\node[reason,text width=3.8cm,anchor=west,font=\fontsize{8.5}{11}\selectfont] at ($(finite-out)!.5!(finite-in)+(.3,0)$) {\Tx{切替または広い区間へ}{Switch or regain wide intervals}\\[3pt]\Cite{finite-branch}};
\coordinate (infinite-out) at ($(infinite.south)+(-2.1,0)$);
\coordinate (infinite-in) at ($(recover.north)+(3.15,0)$);
\draw[edge] (infinite-out)--(infinite-in);
\node[reason,text width=3.8cm,anchor=west,font=\fontsize{8.5}{11}\selectfont] at ($(infinite-out)!.5!(infinite-in)+(.3,0)$) {\Tx{全時間化の後に射影}{Project after full-time localization}\\[3pt]\Cite{infinite-branch}};
\node[result,below=1.8cm of recover] (done) {\heading{4}{最適性に矛盾し、主定理を得る}{Contradict optimization and conclude}
\Tx{時間改善または過剰な細さ $\Rightarrow$ 正のhorizonの反例を排除}{Better time cost or excess narrowness $\Rightarrow$ no positive-horizon counterexample}\\[4pt]
$H(E_i)\le k-k\Delta/2+o_i(1)<k\quad\text{or}\quad\ell_{\mathrm{out}}>\ell$
\qquad $\boxed{\dim_{\mathrm H}K=4}$};
\flow{recover}{done}{\Tx{有限の場合の回収条件と、全場合を閉じる最終論証}{Finite-case recovery and the final closure of all regimes}\\[3pt]\Cite{conversion-diagram}\quad\Cite{completion}};
