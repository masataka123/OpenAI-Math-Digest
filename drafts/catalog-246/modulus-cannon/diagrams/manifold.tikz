\node[card] (a) {\heading{01}{捩れなしの追加仮定}{Add torsion-freeness}$G$ \Tx{は捩れなし}{is torsion-free},\quad $G\curvearrowright\mathbb H^3$\\\Tx{固有・余コンパクトな等長作用}{Proper cocompact isometric action}};
\node[card,below=1.9cm of a] (b) {\heading{02}{有限点固定群が自明になる}{Finite point stabilizers become trivial}$|G_x|<\infty\quad\Longrightarrow\quad G_x=\{1\}\quad(x\in\mathbb H^3)$};
\flow{a}{b}{\Tx{固有性による有限性と捩れなしを組み合わせる}{Combine finite stabilizers from properness with torsion-freeness}\\[3pt]\Cite{manifold}};
\node[result,below=1.9cm of b] (c) {\heading{03}{閉双曲多様体の基本群を得る}{Identify the fundamental group of a closed hyperbolic manifold}$M=\mathbb H^3/G,\qquad \pi_1(M)\cong G$\\\Tx{向き付け可能性は要求しない}{Orientability is not required}};
\flow{b}{c}{\Tx{自由作用・余コンパクト性・普遍被覆の単連結性}{Free action, cocompactness, and a simply connected universal cover}\\[3pt]\Cite{manifold}};
