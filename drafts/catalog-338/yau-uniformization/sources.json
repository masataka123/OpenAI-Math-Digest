  "statements": [
    {
      "result": "Theorem 1.1",
      "pages": "2",
      "hypotheses": "Connected noncompact complex M, dim_C M=n>=1, admits smooth complete Kähler g with pointwise strictly positive holomorphic bisectional curvature.",
      "conclusion": "M is biholomorphic to C^n.",
      "checking": "仮定・量化・全結論・非仮定（上界、体積成長、位相）を照合。"
    },
    {
      "result": "Theorem 6.3",
      "pages": "48",
      "hypotheses": "Flow of Theorem 3.1, N(x,xi,t)=|xi|^2_(h_t^{-1}); v is the lower semicontinuous disc envelope for a finite horizon T.",
      "conclusion": "N(x,xi,exp(w+bar w)) is psh on T*^(1,0)M x C; v=N for all 0<t<T, every finite T.",
      "checking": "楕円体→比較原理→生の円板不等式→pshの接続を照合。"
    },
    {
      "result": "Proposition 9.2",
      "pages": "71",
      "hypotheses": "Charts of Proposition 7.7 and models of Proposition 8.1 with the parameter order in §9.1; 0<gamma<gamma prime<min(sigma/2,1).",
      "conclusion": "Locally uniform corrected-coordinate limit is injective holomorphic, fixes o at 0, is biholomorphic onto open Omega; forward smallness on every compact of Omega and inverse-ball inclusion.",
      "checking": "各結論とpp.71–73の証明箇所を照合。"
    }
  ],
  "proofPassages": [
    {
      "pages": "5–8, 12",
