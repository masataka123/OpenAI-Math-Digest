  "diagrams": [
    {
      "id": "denominator",
      "nodes": [
        {
          "ja": "低次元の指数を固定する",
          "en": "Fix lower-dimensional indices",
          "math": "$L_j\\ (j<n),\\quad f:X\\to Z,\\quad X\\ \\mathrm{klt},\\ B_X=0,\\ \\dim Z>0.$\\\\ $K_X\\sim_{\\mathbb Q}f^*D_0.$"
        },
        {
          "ja": "実際の因子の標準束公式を作る",
          "en": "Construct the exact canonical bundle formula",
          "math": "$K_X+p_0^{-1}\\operatorname{div}(\\psi)=f^*(K_Z+B_Z+M_Z).$"
        },
        {
          "ja": "退化指標を成分上の留数で抑える",
          "en": "Bound degeneration characters using residues",
          "math": "$w_u(\\eta_i)=0,\\quad \\lambda_i^N=1,\\quad j=\\dim S<n.$"
        },
        {
          "ja": "moduli の Cartier 分母を固定する",
          "en": "Fix the Cartier denominator of the moduli part",
          "math": "$p=p_0 n!N,\\qquad p\\mathbf M\\ \\text{b-Cartier}.\\quad\\textbf{Proposition 4.1}$"
        }
      ],
      "edges": [
        {
          "ja": "生成ファイバーの指数と定性的な標準束公式を使う。",
          "en": "Use the generic-fibre index and qualitative bundle formula.",
          "refs": [
            {
              "key": "U",
              "label": "Prop. 4.1, pp. 11--12"
            }
          ]
        },
        {
          "ja": "半安定化後の dlt 成分へ留数を取り、$L_j$ を適用する。",
          "en": "Take residues on dlt components after semistable reduction; apply $L_j$.",
          "refs": [
            {
              "key": "U",
              "label": "Lemmas 3.3, 4.3, pp. 8, 14--17"
            },
            {
              "key": "LA",
              "label": "[LA] Thm. 11.1, p. 73"
            }
          ]
        },
        {
          "ja": "分岐次数ではなく体積形式の指標を殺し、係数の分母を消す。",
          "en": "Kill volume-form characters to clear coefficients; ramification need not be bounded.",
          "refs": [
            {
              "key": "U",
              "label": "(4.6)--(4.7), p. 14; Sec. 4.4, p. 17"
            }
          ]
        }
      ]
    },
    {
      "id": "index",
      "nodes": [
        {
          "ja": "高指数列に帰着する",
          "en": "Reduce to a high-index sequence",
          "math": "$r\\to\\infty,\\quad\\pi:Y\\to V,\\quad K_Y\\sim0,\\quad\\operatorname{Bir}(V)\\ \\text{countable}.$"
        },
        {
          "ja": "被覆と対角積に反対向きの評価を得る",
          "en": "Compare cover and diagonal-product positivity",
          "math": "$\\varepsilon(\\pi^*L)\\ge c_nr^{1/n},\\quad Z_t=Y^t/G_{\\rm diag},\\quad\\varepsilon(P_t)\\le Ct^2.$"
        },
        {
          "ja": "葉の座標を有理的に回収する",
          "en": "Recover a missing leaf coordinate rationally",
          "math": "$P_t^{h_t}H_t\\le(h_tB)^{h_t},\\quad W_k\\dashrightarrow W_{k-1}\\ \\text{birational}.$"
        },
        {
          "ja": "可算性との矛盾から零境界指数へ",
          "en": "Contradict countability and bound the klt index",
          "math": "$\\{\\text{local flows}\\}\\subset\\operatorname{Bir}(V)\\quad\\Longrightarrow\\quad K_n.$"
        },
        {
          "ja": "境界の Stein 次数と norm で lc 指数へ",
          "en": "Use boundary Stein degree and norm for the lc index",
          "math": "$K_n+L_{<n}\\Longrightarrow L_n:\\quad a(n,\\Phi)(K_X+B)\\sim0.$"
        }
      ],
      "edges": [
        {
          "ja": "低次元 $I_j$ の scalar 評価と Frobenius 対角の行列式を使う。",
          "en": "Use lower-dimensional $I_j$, scalar bounds and the Frobenius-diagonal determinant.",
          "refs": [
            {
              "key": "U",
              "label": "Props. 5.1, 6.1, 7.1, pp. 20, 24, 31"
            }
          ]
        },
        {
          "ja": "鎖の葉の次数を抑え、座標忘却の次数1を強制する。",
          "en": "Bound chain-leaf degrees and force a degree-one forgetting map.",
          "refs": [
            {
              "key": "U",
              "label": "Prop. 8.1, pp. 37--39"
            },
            {
              "key": "Ufour",
              "label": "[U4] Lemmas 5.1, 5.4; pp. 18, 21"
            }
          ]
        },
        {
          "ja": "有理的な座標回収で局所 flow を双有理写像にする。",
          "en": "Rational recovery turns local flows into birational self-maps.",
          "refs": [
            {
              "key": "U",
              "label": "(8.7)--(8.8), pp. 39--40"
            }
          ]
        },
        {
          "ja": "水平な係数1成分の留数と有界な Stein 次数を使う。",
          "en": "Use residues on a horizontal coefficient-one component and a bounded Stein degree.",
          "refs": [
            {
              "key": "U",
              "label": "Prop. 3.2, pp. 6--8"
            },
            {
              "key": "SD",
              "label": "[SD] Thm. 1.1, p. 1"
            }
          ]
        }
      ]
    },
    {
      "id": "iitaka",
      "nodes": [
        {
          "ja": "良いモデルで飯高写像を表す",
          "en": "Represent the Iitaka fibration on a good model",
          "math": "$X\\dashrightarrow V\\xrightarrow{f}Z,\\quad K_V\\ \\text{semiample},\\quad H^0(X,mK_X)=H^0(V,mK_V).$"
        },
        {
          "ja": "底の次元に応じて一様次数を選ぶ",
          "en": "Choose a degree according to the base dimension",
          "math": "$\\dim Z=0:\\ L_n;\\qquad\\dim Z>0:\\ D_Z\\ \\text{big},\\quad p\\mathbf M\\ \\text{b-Cartier}.$"
        },
        {
          "ja": "完全系の切断比で底の全関数体を得る",
          "en": "Recover the full base field from complete-system ratios",
          "math": "$H^0(V,mK_V)=\\psi^{m/p_0}f^*H^0(Z,\\lfloor mD_Z\\rfloor),\\quad p_0\\mid m.$"
        },
        {
          "ja": "共通倍数と基礎体の降下で閉じる",
          "en": "Take a common multiple and descend the field",
          "math": "$k(\\text{ratios of }|m(n)K_X|)=K(K_X).\\quad\\textbf{Theorem 1.1}$"
        }
      ],
      "edges": [
        {
          "ja": "[LA] から得た良いモデル上で、点の場合と big な底を分ける。",
          "en": "Use the good model from [LA] and split the point and big-base cases.",
          "refs": [
            {
              "key": "LA",
              "label": "[LA] Thm. 11.1, p. 73"
            },
            {
              "key": "U",
              "label": "Lemma 9.1; proof of Thm. 1.1, p. 41"
            }
          ]
        },
        {
          "ja": "固定係数・nef 分母の有効双有理性を底に適用する。",
          "en": "Apply effective birationality with fixed coefficients and nef denominator.",
          "refs": [
            {
              "key": "BZ",
              "label": "[BZ] Thm. 1.3, p. 3"
            },
            {
              "key": "U",
              "label": "Cor. 4.4, (4.10), p. 17"
            }
          ]
        },
        {
          "ja": "切断比は正の整数倍で保たれ、忠実平坦性で降下する。",
          "en": "Positive multiples preserve section ratios; faithful flatness gives descent.",
          "refs": [
            {
              "key": "U",
              "label": "Sec. 9, pp. 41--42"
            }
          ]
        }
      ]
    }
  ]
}
