\begin{tikzpicture}
\node[card] (n0) {\heading{01}{二つの端点計量を正則化して比較する}{Regularize and compare the two endpoint metrics}\Tx{$L-C_0,\ L-C_2:\ \nu=0,\quad 0<\lambda<1.$\\[3pt]$E=\lfloor C_1\rfloor-\lfloor C_0\rfloor,\quad s:L_1\to L_0\text{ は縮小写像。}$}{$L-C_0,\ L-C_2:\ \nu=0,\quad 0<\lambda<1.$\\[3pt]$E=\lfloor C_1\rfloor-\lfloor C_0\rfloor,\quad s:L_1\to L_0\text{ is a contraction.}$}};
\node[card,below=2.1cm of n0] (n1) {\heading{02}{通常の類写像と一様な原始形を準備する}{Prepare the ordinary class map and uniform primitives}\Tx{$\kappa_k:Z^1_{h_k}\longrightarrow H^1(V,K_V\otimes F).$\\[3pt]$f\in\ker\kappa_k\ \Rightarrow\ \bar\partial v=f,\quad\|v\|_k\le C\|f\|_k\quad(C\text{ independent of }k).$}{$\kappa_k:Z^1_{h_k}\longrightarrow H^1(V,K_V\otimes F).$\\[3pt]$f\in\ker\kappa_k\ \Rightarrow\ \bar\partial v=f,\quad\|v\|_k\le C\|f\|_k\quad(C\text{ independent of }k).$}};
\flow{n0}{n1}{\Tx{有界な局所ポテンシャル、固定被覆のcocycle、指定した一つのseminormを使う。}{Use bounded local potentials, fixed-cover cocycles and one prescribed seminorm.}\\[4pt]\Cite{mm}{Lemmas 3.1--3.2, Prop. 3.3, pp. 11--16}}
\node[card,below=2.1cm of n1] (n2) {\heading{03}{核の類の調和代表を評価する}{Estimate harmonic representatives of a kernel class}\Tx{$A_{1,k}\ge(1-\lambda)A_{0,k}\ge0,\qquad C_\lambda=(1-\lambda)^{-1}.$\\[3pt]$\|\bar\partial_{0,k}^*(su_k)\|_{0,k}=O(\sqrt{\varepsilon_k}).$}{$A_{1,k}\ge(1-\lambda)A_{0,k}\ge0,\qquad C_\lambda=(1-\lambda)^{-1}.$\\[3pt]$\|\bar\partial_{0,k}^*(su_k)\|_{0,k}=O(\sqrt{\varepsilon_k}).$}};
\flow{n1}{n2}{\Tx{log-sum重みで縮小性と曲率比較を両立させ、完備計量上でBochnerを使う。}{Log-sum weights give contraction and curvature comparison for Bochner.}\\[4pt]\Cite{mm}{(3.1)--(3.6), (3.11)--(3.13), pp. 12--17}}
\node[card,below=2.1cm of n2] (n3) {\heading{04}{一様な原始形と対にして像を消す}{Pair with uniform primitives to make the image small}\Tx{$\kappa_{0,k}(su_k)=0\Rightarrow\bar\partial v_k=su_k,\quad\sup_k\|v_k\|<\infty.$\\[3pt]$\|su_k\|_{0,k}^2=\langle v_k,\bar\partial_{0,k}^*(su_k)\rangle\longrightarrow0.$}{$\kappa_{0,k}(su_k)=0\Rightarrow\bar\partial v_k=su_k,\quad\sup_k\|v_k\|<\infty.$\\[3pt]$\|su_k\|_{0,k}^2=\langle v_k,\bar\partial_{0,k}^*(su_k)\rangle\longrightarrow0.$}};
\flow{n2}{n3}{\Tx{固定被覆の類写像と開写像定理で、核に一様有界な原始形を供給する。}{The fixed-cover class map and open mapping supply uniformly bounded primitives.}\\[4pt]\Cite{mm}{Prop. 3.3, (3.14), pp. 14--17}}
\node[result,below=2.1cm of n3] (n4) {\heading{05}{固定空間で通常の類を保持する}{Retain the ordinary class in a fixed Hilbert space}\Tx{$u_k\rightharpoonup0,\quad\kappa_*(u_k)=[\gamma]\quad\Rightarrow\quad[\gamma]=0.$\\[3pt]$H^1(K_V+L_1)\hookrightarrow H^1(K_V+L_0)\ \Rightarrow\ H^0(K_V+L_0)\twoheadrightarrow H^0(E,(K_V+L_0)|_E).$}{$u_k\rightharpoonup0,\quad\kappa_*(u_k)=[\gamma]\quad\Rightarrow\quad[\gamma]=0.$\\[3pt]$H^1(K_V+L_1)\hookrightarrow H^1(K_V+L_0)\ \Rightarrow\ H^0(K_V+L_0)\twoheadrightarrow H^0(E,(K_V+L_0)|_E).$}};
\flow{n3}{n4}{\Tx{変動する重みから一つの固定Hilbert空間へ移し、弱連続性を使う。}{Pass from varying weights to one fixed Hilbert space and use weak continuity.}\\[4pt]\Cite{mm}{(3.15), $\S$3.5, pp. 17--18}\quad \Cite{mm}{(1.1), p. 2}}
\end{tikzpicture}
