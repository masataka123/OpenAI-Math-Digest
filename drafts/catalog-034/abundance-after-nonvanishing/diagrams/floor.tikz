\begin{tikzpicture}
\node[card] (n0) {\heading{01}{同じ周囲の線束を持つnormal strata}{Normal strata carrying one ambient line}$L_Z=\mathcal O_Z(q(K_Z+B_Z))=L|_Z,\quad q\text{ even}$};
\node[card,below=2.0cm of n0] (n1) {\heading{02}{二つのmarkingによるresidue比較}{Residue comparison from two markings}$F\simeq\mathbb P^1,\quad\{0,\infty\};\qquad (dz/z)^{\otimes q}$};
\flow{n0}{n1}{\Tx{DOで三次元成分を生成。torsion-freeな障害とMori fiberが延長条件を一つのlinkへ帰着。}{DO generates the three-dimensional components; a torsion-free obstruction and a Mori fibre reduce extension to one link.}\\[4pt]\CiteSource{DO}{DO Cor. 1.3, p. 4}\quad \CiteSource{K4N}{Lem. 7.1, pp. 51--52; Prop. 7.3, pp. 56--58}}
\node[card,below=2.0cm of n1] (n2) {\heading{03}{固定次数での有限像}{Finite images in a fixed degree}$c_Z^2>0,\quad c_{Z_1}-\tau^*c_{Z_2}\in\operatorname{NS}(P_1)_{\mathbb R}$};
\flow{n1}{n2}{\Tx{非射影曲面では三次元strata由来のlinkだけを使い、一つのKähler類を輸送する。}{For nonprojective surfaces use only links from three-dimensional strata and transport one ambient Kähler class.}\\[4pt]\CiteSource{K4N}{Prop. 8.1; Lems. 8.2--8.3, pp. 59--61}}
\node[result,below=2.0cm of n2] (n3) {\heading{04}{全交差で整合し、被約floorを生成}{Match every intersection and generate the reduced floor}$\prod_{g\in G_Z}g(s_Z)\quad\Longrightarrow\quad L^k|_S\text{ globally generated}$};
\flow{n2}{n3}{\Tx{下位から延長しnorm積で不変化。有限超平面回避で非消滅を保ち、全floorへ降下。}{Extend from lower strata and take invariant norms; avoid finitely many hyperplanes and descend to the whole floor.}\\[4pt]\CiteSource{K4N}{Prop. 6.3, pp. 48--50; Lem. 9.1 / Prop. 9.2, pp. 63--65}}
\end{tikzpicture}
