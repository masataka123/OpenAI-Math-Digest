\node[card] (a) {\heading{1}{Free 次数の descendant に定量的下界}{A quantitative descendant bound in free degrees}
\Tx{Proposition 3.1：後の超指数的減衰と両立しない下界}{Proposition 3.1: a lower bound incompatible with superexponential decay}\\
$\langle\tau_{d-2}(\mathrm{pt})\rangle_\beta\ge(ad)^{-(d-1)}$};
\node[card,below=3.0cm of a] (b) {\heading{2}{量子因子の独立な同時固有値組}{An independent joint tuple of quantum divisors}
\Tx{Proposition 4.1：$\lambda_1,\ldots,\lambda_r$ は $\mathbb C$ 上代数的独立}{Proposition 4.1: $\lambda_1,\ldots,\lambda_r$ are algebraically independent over $\mathbb C$.}};
\flow{a}{b}{\Tx{漸化式と free 次数の稠密性を合わせ、従属を仮定して矛盾へ。}{Add the recurrence and density of free degrees; dependence gives a contradiction.}\\\Cite{recurrence}\\\Cite{free-direction}\\\Cite{independence}};
\node[result,below=2.5cm of b] (c) {\heading{3}{独立な非零積と主定理の不等式}{An independent nonzero product and the inequality}
$S_{\gamma_1}\cdots S_{\gamma_r}\ne0,\quad \gamma_1,\ldots,\gamma_r\text{ independent}$\\
$\displaystyle r(\iota-1)\le\sum_{j=1}^r(d_{\gamma_j}-1)\le n$};
\flow{b}{c}{\Tx{交代トレースから独立な非零項を取り、次数の減少量を数える。}{Extract an independent nonzero term from the alternating trace; count the grading drop.}\\\Cite{trace-interpolation}\\\Cite{inequality}};
\node[result,below=3.4cm of c] (d) {\heading{4}{等号の場合の分類}{Classification at equality}
$\displaystyle r(\iota-1)=n\quad\Longrightarrow\quad X\simeq(\mathbb P^{\iota-1})^r$\\
\Tx{Proposition 6.4：上で得た独立な非零積を入力にする}{Proposition 6.4 uses the independent nonzero product obtained above.}};
\flow{c}{d}{\Tx{等号なら全次数が $\iota$。実際の曲線族へ移り、全族を covering にする。}{Equality makes every degree $\iota$. Pass to actual curve families and make all of them covering.}\\\Cite{proper-family}\\\Cite{covering}\\\Cite{classification}};
\node[card,below=2.0cm of d] (e) {\heading{5}{積の不変量を計算し、逆向きも確認}{Compute the product invariants for the converse}
$\dim X=r(\iota-1),\quad \rho_X=r,\quad \iota_X=\iota$\\
\Tx{$\iota=1$ では初めから $0<n$。これで Theorem 1.1 の全結論を得る。}{For $\iota=1$, start with $0<n$. All conclusions of Theorem 1.1 now follow.}};
\flow{d}{e}{\Tx{各因子の直線と反標準因子から pseudoindex を確認する。}{Check the pseudoindex using lines in the factors and the anticanonical divisor.}\\\Cite{classification}};
