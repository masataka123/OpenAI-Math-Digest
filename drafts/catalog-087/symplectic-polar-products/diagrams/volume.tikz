\node[card] (a) {\heading{1}{内部と閉体の体積を同定}{Identify interior and closed-body volumes}
$tC\subset\operatorname{int}C\ (0<t<1),\quad t\uparrow1$\\
$\operatorname{vol}_{2n}(U_K)=\operatorname{vol}_n(K)\operatorname{vol}_n(K^\circ)$};
