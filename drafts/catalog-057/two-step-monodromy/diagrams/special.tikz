\node[card] (start) {\heading{1}{残した例外曲線と対数標準因子}{Retained exceptional curves and the log canonical divisor}
$j^*q_i=D_i+A_i,\quad m_j(q_i)=\min(\infty,1)=1$\\
$K_Y+D\sim j^*\mathcal O_{\mathbb P^1}(n-2),\quad \kappa(Y,K_Y+D)=1$.};
\node[card,below=2cm of start] (models) {\heading{2}{任意のupper modelで底の次元を分ける}{Test every upper model by base dimension}
$u:(Y',D')\longrightarrow(Y,D),\qquad g:Y'\longrightarrow Z\text{ neat}$.\\
\Tx{$u$はelementary birational orbifold morphism。}{Here $u$ is an elementary birational orbifold morphism.}};
\flow{start}{models}{\Tx{切断の増大度とinfimum multiplicityを各モデルへ移す}{Transport section growth and infimum multiplicities to each model}\\\Cite{surface-geometry}\quad\Cite{convention}};
\node[half,below=2.3cm of models.south west,anchor=north west] (surface) {\heading{$\dim Z=2$}{双有理の底}{Birational base}
$H^0(Y',m(K_{Y'}+D'))$\\$\hookrightarrow H^0(Y,m(K_Y+D))$\\
\Tx{切断増大は一次：$\kappa(K_Z+\Delta)\le1<2$。}{Linear growth gives $\kappa(K_Z+\Delta)\le1<2$.}};
\node[half,below=2.3cm of models.south east,anchor=north east] (curve) {\heading{$\dim Z=1$}{楕円曲線slice}{Elliptic slices}
$0\ge\deg(h)\deg(K_C+\Delta)>0$\\
\Tx{非定数sliceを排除し、$g=j\circ u$へ帰着。}{Exclude nonconstant slices; reduce to $g=j\circ u$.}\\
$A_i'\Rightarrow\Delta(j\circ u,D')=0$.};
