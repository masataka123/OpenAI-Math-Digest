\draw[edge] ($(models.south east)+(-6.7,0)$)--($(curve.north west)+(.25,0)$);
\node[reason,text width=5.6cm,anchor=south west] at ($(surface.north west)+(.65,.4)$) {\Tx{余次元2での延長とneat性}{Extension in codimension two and neatness}\\\Cite{special-proof}};
\node[reason,text width=5.6cm,anchor=south west] at ($(curve.north west)+(.65,.4)$) {\Tx{Riemann--Hurwitzと重複度1}{Riemann--Hurwitz and multiplicity one}\\\Cite{special-proof}};
\node[result,below=2cm of $(surface.south)!.5!(curve.south)$] (end) {\heading{3}{全モデルで一般型の底を排除}{Exclude general-type bases on all models}
\Tx{$(Y,D)$はDefinition 4.1の意味でspecial。}{$(Y,D)$ is special in the sense of Definition 4.1.}};
