\node[card] (a) {\heading{1}{分離した代数的関数と零グラフ}{Separate algebraic functions and zero graphs}
$S_t=\sum_iF_i+\sum_{i\in I}t_ib_i,\qquad t_i^2=0,\qquad |I|\geq5$\\
$S_t(H_L)=S_0(H_R)=0,\quad T_0H_L\oplus T_0H_R=K^N$};
\node[card,below=1.8cm of a] (b) {\heading{2}{有限Frobenius複体の非零pairing}{Nonzero pairing in a finite Frobenius complex}
$\Omega_p=\Omega^\bullet_{k[z]/(z_\nu^p)},\quad D=dS_0\wedge,\quad
\int U_0\wedge V\ne0$};
\flow a b {\Tx{最終方程式をArtin近似し、有限係数環から特殊化}{Approximate the final equations; specialize a finite coefficient ring}\\\Cite{artin}\\\Cite{approximation}};
\node[card,below=1.8cm of b] (c) {\heading{3}{三つ以上の適したactive因子}{At least three suitable active factors}
$[V']\in\bigotimes_iH_i,\qquad B_iv_i=\delta_iv_i=0\ \text{in at least }m-2\geq3\text{ slots}$\\
$\int U_0\wedge V'=\int U_0\wedge V$};
\flow b c {\Tx{target三次則とkernelを保つchain projection}{Use the target triple law and a kernel-preserving chain projection}\\\Cite{projection}};
\node[result,below=1.8cm of c] (d) {\heading{4}{各tensorのpairingが零}{Every tensor pairing vanishes}
$(D_i+t_i db_i\wedge)(a_i+t_iw_i)=0$\\
$t_it_jt_kP(t)=0\quad\Longrightarrow\quad P(0)=0$\\
\Tx{全tensorについて加えると非零pairingに矛盾。}{Summing over tensors contradicts the nonzero pairing.}};
\flow c d {\Tx{source三次則の実boundaryとliftを同じ複体でpairing}{Pair the actual source-triple boundary with the lifts in the same complex}\\\Cite{lifts}};
