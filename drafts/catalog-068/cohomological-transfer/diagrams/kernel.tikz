\node[card] (n0) {\heading{}{底だけに連続性を許した随伴係数}{Adjoint coefficient with continuity only on the base}$A=D_V+kf^*Q,\quad k\ge0,\quad \Theta_{D_V}=\theta\ge0,\quad \ker\theta\subseteq\ker df$};
\node[card,below=2.35cm of n0] (n1) {\heading{}{一様近似と零曲率エネルギーの極限}{Uniform approximation and a zero-energy limit}$u_j\rightharpoonup u=\omega^\ell\wedge v,\quad v\text{ holomorphic},\quad [\theta,\Lambda]u=0,\quad \partial(hv)=0$};
\flow{n0}{n1}{\Tx{小さい負曲率を許し、弱極限で元の類を保つ}{Allow a small negative curvature error and retain the class in the weak limit}\\\Cite{smoothing}\quad\Cite{richberg}\\\Cite{harmonic-limit}};
\node[card,below=2.35cm of n1] (n2) {\heading{}{底の標準因子を外してファイバーで検出}{Remove the base canonical factor and detect on a fiber}$v=f^*(dy_1\wedge\cdots\wedge dy_b)\wedge w,\quad \omega_y^\ell\wedge w_y\text{ harmonic}$\\$H^\ell(V,K_V+A)\hookrightarrow H^0(Y,R^\ell f_*(K_V+D_V)\otimes Q^k)$};
\flow{n1}{n2}{\Tx{kernel条件と正則性で底のwedge因子を強制、垂直Chern方程式}{Kernel inclusion forces the base wedge factors; use the vertical Chern equation}\\\Cite{fiber-detection}};
\node[result,below=2.35cm of n2] (n3) {\heading{}{分解の零列との比較で全消滅へ}{Compare with the zero column of the splitting}$h^\ell(V,K_V+A)=\sum_{p+q=\ell}h^p(Y,R^qf_*(K_V+D_V)\otimes Q^k)$\\$\Longrightarrow\ H^p(Y,R^qf_*(K_V+D_V)\otimes Q^k)=0\quad(k,q\ge0,\ p>0)$};
\flow{n2}{n3}{\Tx{滑らかな係数$D_V$を分解後に$Q^k$を捻り、edge単射と次元比較}{Split the smooth coefficient $D_V$, then twist by $Q^k$ and compare dimensions}\\\Cite{fujisawa}\quad\Cite{kernel-end}};
