\node[card] (n0) {\heading{1}{null条件を持つ近似列}{Approximating divisors on the null face}$N_j\sim m_jL+M,\quad \ell(N_j)=0,\quad v(N_j)/m_j\to0$};
\node[card,below=2.0cm of n0] (n1) {\heading{2}{共通の関数体と底}{Common field and base}$k=\{h:\ell((h)_\infty)=0\},\quad \mathrm{rk}\,g_*\mathcal O_Z(K_{Z/X})=1$};
\flow{n0}{n1}{\Tx{nullな極の体の相対代数閉性と水平strict patch}{Relative algebraic closedness of the null-polar field and a strict horizontal patch}\\[3pt]\Cite{null-field}};
\node[card,below=2.0cm of n1] (n2) {\heading{3}{可積分計量と有限生成}{Integrable metric and finite generation}$p_*f^*A_0=0,\quad R(Y;k_0(A_0+\epsilon P_1),k_0(A_0+\epsilon P_0))$};
\flow{n1}{n2}{\Tx{toroidal volumeとunweighted可積分性を有限生成へ}{Toroidal volume and unweighted integrability supply finite generation}\\[3pt]\Cite{ring}};
\node[result,below=2.0cm of n2] (n3) {\heading{4}{境界rayで厳密達成}{Exact attainment on the boundary ray}$N\sim_{\mathbb Q}L,\quad N\geq0,\quad v(N)=0$};
\flow{n2}{n3}{\Tx{係数のvaluationで生成元を選び、補正を除去}{Select a generator by coefficient valuation and remove the correction}\\[3pt]\Cite{endpoint}};
