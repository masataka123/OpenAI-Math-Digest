\flow{cycles}{deficit}{\Tx{girthで付着の余分なcycleを抑え、消去順で重複を避ける}{Girth bounds extra attachment cycles; elimination avoids double counting}\\\Cite{deficit}};
\node[card,below=2cm of deficit] (gap) {\heading{4}{有効成分と残りの双方に一様gapを得る}{Obtain a uniform gap on copies and the remainder}
$\pi_\omega(T)|_{\ell^2(U_\omega)}\geq c^2/(8d)$,\quad $\varepsilon=\min\{\rho,c^2/(8d)\}>0$\\
