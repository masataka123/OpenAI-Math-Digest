\node[card] (local) {\heading{1}{invalidコピーで辺が不足する}{Missing edges on invalid copies}
$X_\omega|_P-w_P\in C_P\setminus\{0\}$,\quad $|\operatorname{supp}(X_\omega|_P-w_P)|>\eta|P|$\\
$d|B|-2e_{\omega,P}(B)\geq c|B|$\quad $(B\subset P)$};
\node[card,below=2cm of local] (cycles) {\heading{2}{cycle座標を遠いコピーから消去する}{Eliminate cycle coordinates from farthest copies}
$Z_1(X;\mathbb F_2)=\bigoplus_P Z_1(P;\mathbb F_2)$\\
