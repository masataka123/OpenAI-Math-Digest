\flow{local}{cycles}{\Tx{相殺で生じる追加の辺は同時交差球 $B_P$ 内に入る}{Extra edges created by cancellation lie inside the overlap ball $B_P$}\\\Cite{cycles}; \Cite{deficit}};
\node[card,below=2cm of cycles] (deficit) {\heading{3}{互いに素な外側頂点へ階数を配分する}{Charge rank to disjoint exterior vertex sets}
