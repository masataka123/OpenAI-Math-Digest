\node[card] (a) {\heading{1}{局所化Bott族を有限Cayley式で近似}{Approximate localized Bott families by finite Cayley formulas}
$a_i=p_i-e$,\quad $\|b_f-UDIf^{\mathrm{mod}}I^*DU^*\|<\eta$.\\[3pt]
\Tx{全正則ノルム、全高さで一様。固定行列サイズ。}{Full regular norm, uniform over all heights; fixed matrix size.}};
\node[card,below=1.85cm of a] (b) {\heading{2}{商で正確な準同型と道を得る}{Obtain an exact homomorphism and paths in the quotient}
$Q_r=\prod_\nu C_r^*(\Gamma_\nu)/\bigoplus_\nu C_r^*(\Gamma_\nu)$,\quad
$\Theta:\mathcal B\to Q_r$.\\[3pt]
\Tx{$\mathcal B$ は有界model族と二つの連続な道から生成。}{The algebra $\mathcal B$ is generated by bounded model families and two continuous paths.}};
\flow a b {\Tx{同時sampling・定数抽出・forest評価から一様mesh近似}{Uniform mesh approximation via sampling, constant extraction and forest bounds}\\[3pt]\Cite{realization}\quad\Cite{source-algebra}};
\node[card,below=1.8cm of b] (c) {\heading{3}{偶数から奇数、正の偶数へ移す}{Move even to odd to positive-even heights}
$b_I=[e+A_I]-[e]\in K_0(\mathcal B)$,\\[3pt]
$b_{\mathrm{ev}}=b_{\mathrm{od}}=b_{\mathrm{ev},+}$,\quad
$b_{\mathrm{ev}}=b_0+b_{\mathrm{ev},+}$\quad$\Longrightarrow\quad b_0=0$.};
\flow b c {\Tx{互いに素な隣接対の回転・再スケールと有限加法性}{Rotate and rescale disjoint adjacent pairs; use finite additivity}\\[3pt]\Cite{parity}};
\node[card,below=1.8cm of c] (d) {\heading{4}{初項を物理的トーラスBott類に戻す}{Identify the root with the physical torus Bott class}
$v^*va^{\mathrm{phys}}=a^{\mathrm{phys}}$,\quad $\Theta(A_0)=va^{\mathrm{phys}}v^*$.\\[3pt]
$[e+a^{\mathrm{phys}}]-[e]=\Theta_*(b_0)=0\quad\text{in }K_0(Q_r)$.};
\flow c d {\Tx{台上の等長性だけを使う固定サイズの射影道}{A fixed-size projection path using isometry only on the support}\\[3pt]\Cite{transport}};
\node[result,below=1.8cm of d] (e) {\heading{5}{十分遅い一つの座標で整数消滅}{Integral vanishing at sufficiently late coordinates}
$\beta\longmapsto0\quad\text{in }K_0(C_r^*(\Gamma_\nu))\qquad(\nu\gg0)$.\\[3pt]
\Tx{高さ $i$ と精度 $\nu$ を区別し、有限証拠のサイズを固定する。}{Distinguish height $i$ from accuracy $\nu$ and keep the witness size finite and fixed.}};
\flow d e {\Tx{商の証拠を持ち上げ、スペクトル切断・極分解で補正}{Lift the quotient witness; correct it by spectral cutting and polar normalization}\\[3pt]\Cite{finite-witness}\quad\Cite{bott}};
