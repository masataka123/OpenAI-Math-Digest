\node[card] (a) {\heading{1}{グラフに沿って明示的な束$G$を構成}{Construct the explicit graph-defined bundle $G$}
$S=\mathbf P^1\times\mathbf P^1,\quad P=\mathcal O_S(1,1),\quad E_m=f_m^*G\otimes P$.\\
\Tx{二つの商列と、双対包含のグラフ恒等式を同時に得る}{Obtain both quotient sequences and the dual graph identities}.};
\node[half,below=2.1cm of a.south west,anchor=north west] (b) {\heading{2a}{代数側}{Algebraic side}
$m\ge1,\quad n\text{ even},\quad n-1\ge3m$.\\
$\mathcal O_{\mathbf P(E_m)}(n)$\ \Tx{はvery ample}{is very ample}.\\
\Tx{従って全$m$で$E_m$はample}{Hence $E_m$ is ample for all $m$}.};
\node[half,anchor=north east] (c) at (a.south east |- b.north) {\heading{2b}{解析側の背理法}{Analytic contradiction}
\Tx{無限個の$m$で厳密正値計量があると仮定}{Assume strictly positive metrics for infinitely many $m$}.\\
$q:G^\vee\to[0,\infty),\quad q\not\equiv0$.\\
\Tx{pshかつ全ファイバーで二次}{Psh and quadratic on every fiber}.};
\draw[edge] ($(a.south west)+(0.2,0)$)--($(b.north west)+(0.2,0)$);
\draw[edge] (a.south -| c.north west)--(c.north west);
\node[branchreason,text width=5.4cm,anchor=west] at ($(a.south west)+(0.7,-1.0)$) {\Tx{二つの商から交互フィルトレーション}{Alternate the two quotient sequences}\\\Cite{ample}};
\node[branchreason,text width=5.4cm,anchor=west] at ($(a.south)+(0.9,-1.0)$) {\Tx{双対ノルムの平均と非消失}{Average dual norms and prevent collapse}\\\Cite{limit}};
\node[card,below=2.0cm of b.south west,anchor=north west] (d) {\heading{3}{解析側の極限をグラフ恒等式で排除}{Exclude the analytic limit using the graph identities}
$q\not\equiv0\ \Longrightarrow\ \mu\ge0,\quad\mu(\mathbf P^1)=2\pi b>0,\quad A^*\mu=B^*\mu=\mu$.\\
