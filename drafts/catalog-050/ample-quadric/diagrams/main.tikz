\node[reason,anchor=west] at ($(b.south west)+(0.4,-1.0)$) {\Tx{rulingで降下した半ノルムの対数から測度を得る}{Logarithmic weights of the descended seminorm produce the measure}\\\Cite{seminorm}\quad\Cite{obstruction}};
\node[result,below=1.8cm of d] (e) {\heading{4}{主定理の量化へ戻る}{Recover the quantifiers of the main theorem}
$\forall m\ge1:\ E_m$ \Tx{はample（2aより）}{is ample (from 2a)}.\\
$\exists m_0\ge1\ \forall m\ge m_0:$ \Tx{滑らかな厳密Griffiths正値Hermitian計量なし}{no smooth strictly Griffiths-positive Hermitian metric}.\\
\Tx{$m_0$は非有効。半正値計量の排除は主張しない}{The threshold is ineffective; semipositive metrics are not excluded}.};
\flow{d}{e}{\Tx{正値計量を持つ$m$は有限個、その最大値より先を取る}{Only finitely many $m$ admit positive metrics; take a threshold beyond them}\\\Cite{assembly}};
