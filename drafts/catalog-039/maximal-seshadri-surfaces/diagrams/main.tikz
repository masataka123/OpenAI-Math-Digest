\node[card] (a) {\heading{1}{節点から指数領域を作る}{Build exponent regions from a node}
$V\in|dL|,\quad H=L^2,\quad \nu_t(H^0(kL))\subset kQ_t$\\
$P_t=\operatorname{conv}\{(-b,0),(a,0),(0,1/d)\},\quad \operatorname{area}(P_t)=H/2$};
\node[card,below=2.0cm of a] (b) {\heading{2}{各点数に形と有限群を合わせる}{Tune the shape and group for each point count}
$r\ge r_0:\quad t,G\ \text{\Tx{を固定}{fixed}},\quad |G|=r,\quad w=\sqrt{H/r}$\\
$\forall k,m\in\mathbb Z_{>0},\ m>kw:\quad J^m_G\big|_{\mathcal M(kP_t)}\ \text{\Tx{は単射}{is injective}}$};
\flow{a}{b}{\Tx{原始方向の幅を $\sqrt{rH}$ に調整し、指標ごとの三角形を検査する}{Tune the determinant range to $\sqrt{rH}$; test each character triangle}\\\Cite{subgroup}\\\Cite{tuning}};
\node[card,below=2.1cm of b] (c) {\heading{3}{非常に一般の配置で全jet条件を同時に満たす}{Make all jet tests hold at very general tuples}
$U_r\setminus Z_r\ne\varnothing,\qquad
H^0\!\left(S,kL\otimes\bigcap_i I_{p_i}^m\right)=0\quad(m>kw)$\\
\Tx{$Z_r$ は真のZariski閉集合の可算和}{Here $Z_r$ is a countable union of proper Zariski-closed subsets}};
\flow{b}{c}{\Tx{圧縮と解析的移送で各テストを実現し、開条件とBaire性で共通化}{Compression and analytic transfer give witnesses; openness and Baire give a common locus}\\\Cite{compression}\\\Cite{open}};
\node[result,below=2.0cm of c] (d) {\heading{4}{nef下界と普遍的上界を合わせる}{Combine the nef lower bound and universal upper bound}
$D_0=\pi^*L-w\sum_i E_i\ \text{\Tx{はnef}{is nef}}\quad\Longrightarrow\quad\varepsilon\ge w$\\
$\varepsilon\le w\quad\Longrightarrow\quad\boxed{\varepsilon(S,L;\mathbf p)=\sqrt{L^2/r}}$};
\flow{c}{d}{\Tx{負の曲線を有効化して矛盾を得る；上界は別のjet次元計算}{Make a negative curve produce a forbidden section; count jets separately for the upper bound}\\\Cite{nef}\\\Cite{upper}};
