\node[card] (a) {\heading{1}{旗で切断を指数化する}{Encode sections by a flag}
$S_k\subset k\Delta(1/D,\ldots,1/D,D^{n-1}V)$\\
$\#S_k=h^0(X,kL),\quad S_k+S_l\subset S_{k+l}$};
\node[card,below=2.1cm of a] (b) {\heading{2}{二切片変形を反復する}{Iterate two-intercept reshaping}
$w=(V/r)^{1/n}<\ell/100,\quad P_*=\Delta(w,\ldots,w,rw)$\\
$F_k\subset kP_*,\quad\#F_k=h^0(X,kL),\quad F_k+F_l\subset F_{k+l}$};
\flow{a}{b}{\Tx{最小切片 $\ell$ で全反復の適用条件を確保し、体積・個数・加法性を保つ}{The minimum intercept $\ell$ controls every step; preserve volume, size and additivity}\\[3pt]\Cite{flag}; \Cite{iteration}};
\node[card,below=2.2cm of b] (c) {\heading{3}{内部を埋めて全jetを補間する}{Fill the interior and interpolate full jets}
$\forall\,0<\theta<w,\quad k\gg_\theta1:\quad M(F_k)\twoheadrightarrow\bigoplus_iJ_{(1,\ldots,1,c_i)}^{\lfloor k\theta\rfloor}$\\
\Tx{内部の小単体を平行移動し、中国剰余定理を使う}{Translate a smaller simplex into the interior; apply the Chinese remainder theorem}};
\flow{b}{c}{\Tx{全密度と加法性で内部格子点を確保する}{Full density and additivity supply every interior lattice point}\\[3pt]\Cite{saturation}\\[3pt]\Cite{interpolation}};
\node[result,below=2.6cm of c] (d) {\heading{4}{共通配置で上下界を合わせる}{Match the bounds on a common locus}
$\mathbf p\in U_r(X)\setminus Z_r:\quad w\leq\varepsilon(X,L;\mathbf p)\leq w$\\
$D_w=\pi^*L-w\sum_iE_i\ \Tx{\text{は nef}}{\text{is nef}},\qquad D_w^n=0$};
\flow{c}{d}{\Tx{jetを $X$ へ戻し、可算個の開条件を同時に課す。曲線とblow-upで評価}{Transfer jets to $X$, impose countably many open conditions, then use curve and blow-up bounds}\\[3pt]\Cite{locus}; \Cite{lower}\\[3pt]\Cite{upper}};
