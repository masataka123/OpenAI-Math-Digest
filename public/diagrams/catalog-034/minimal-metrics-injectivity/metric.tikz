\begin{tikzpicture}
\node[card] (n0) {\heading{01}{随伴構造から固定捻りを選ぶ}{Choose a fixed twist from the adjoint structure}\Tx{$N=\pi^*(K_H+\Theta)=K_V+B,\quad B_j<1,\quad B^-\ \pi\text{-exceptional}.$\\[3pt]$mN+A$ は許されたすべての $m$ で大域生成。}{$N=\pi^*(K_H+\Theta)=K_V+B,\quad B_j<1,\quad B^-\ \pi\text{-exceptional}.$\\[3pt]$mN+A$ is globally generated for every allowed $m$.}};
\node[card,below=2.1cm of n0] (n1) {\heading{02}{正のLelong数を仮定し極値切断を取る}{Assume positive Lelong number and maximize evaluation}\Tx{$Q_m(s_m)=1,\ s_m(p)\ne0,\quad \tau_m=m^{-1}\log|s_m|^2.$\\[3pt]$g_m=\varphi+a/m-\tau_m,\quad\varepsilon_m=\int_{\{g_m<-R\}}e^{\tau_m-a/m-b}\to0.$}{$Q_m(s_m)=1,\ s_m(p)\ne0,\quad \tau_m=m^{-1}\log|s_m|^2.$\\[3pt]$g_m=\varphi+a/m-\tau_m,\quad\varepsilon_m=\int_{\{g_m<-R\}}e^{\tau_m-a/m-b}\to0.$}};
\flow{n0}{n1}{\Tx{klt消滅で大域生成。極小性と正規化された重みのコンパクト性を使う。}{Klt vanishing gives generation; minimality and compactness give small mass.}\\[4pt]\Cite{fuj}{[Fuj] Thm. 3.2, p. 734}\quad \Cite{mm}{Claim 2.2, (2.5), pp. 6--7}}
\node[card,below=2.1cm of n1] (n2) {\heading{03}{同じ値を持つ小質量の切断を作る}{Construct a smaller-mass section with the same value}\Tx{$\bar\partial u=\bar\partial(\chi(g_m)s_m),\quad w_m=\chi(g_m)s_m-u.$\\[3pt]$w_m\in H^0(V,mN+A),\quad w_m(p)=s_m(p).$}{$\bar\partial u=\bar\partial(\chi(g_m)s_m),\quad w_m=\chi(g_m)s_m-u.$\\[3pt]$w_m\in H^0(V,mN+A),\quad w_m(p)=s_m(p).$}};
\flow{n1}{n2}{\Tx{逆曲率評価で局所化。正規な基底への降下とHartogs延長で大域化。}{Localize using inverse curvature; descend to the normal base and extend.}\\[4pt]\Cite{mm}{Lemma 2.3, $\S$2.4, pp. 8--10}}
\node[result,below=2.1cm of n2] (n3) {\heading{04}{正規化し直すと極値性に矛盾する}{Renormalization contradicts extremality}\Tx{$Q_m(w_m)^m\le C^\prime\varepsilon_m(1+I)^d\longrightarrow0.$\\[3pt]$\nu(\varphi,p)=0\ \ (\forall p),\qquad\mathcal I(t\varphi)=\mathcal O_V\ \ (t>0).$}{$Q_m(w_m)^m\le C^\prime\varepsilon_m(1+I)^d\longrightarrow0.$\\[3pt]$\nu(\varphi,p)=0\ \ (\forall p),\qquad\mathcal I(t\varphi)=\mathcal O_V\ \ (t>0).$}};
\flow{n2}{n3}{\Tx{固定した上側勾配 $d$ によりHölder評価の定数を一様化する。}{A fixed upper slope $d$ keeps the final Hölder bound uniform.}\\[4pt]\Cite{mm}{(2.15)--(2.17), Cor. 2.4, pp. 10--11}}
\end{tikzpicture}
